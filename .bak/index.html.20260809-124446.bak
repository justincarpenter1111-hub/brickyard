<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Brick Builder</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html, body { height:100%; width:100%; overflow:hidden; position:fixed; overscroll-behavior:none;
    font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  #c { position:absolute; inset:0; touch-action:none; -webkit-touch-callout:none; display:block; }

  .panel { background:rgba(255,255,255,.78); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-radius:18px; box-shadow:0 4px 18px rgba(0,0,0,.12); }

  #topbar { position:absolute; top:calc(env(safe-area-inset-top) + 10px); left:50%; transform:translateX(-50%);
    display:flex; gap:5px; align-items:center; padding:6px; z-index:10; max-width:96vw; }
  .btn { min-width:46px; height:46px; border:none; border-radius:13px; background:rgba(255,255,255,.6);
    font-size:21px; color:#333; display:flex; align-items:center; justify-content:center;
    touch-action:manipulation; cursor:pointer; flex:0 0 auto; }
  .btn:active { background:#d8e8ff; }
  .btn[disabled] { opacity:.32; }
  .btn.on { background:#1a73e8; color:#fff; }
  #count { font-size:14px; font-weight:600; color:#444; padding:0 8px; white-space:nowrap; }

  #hud { position:absolute; left:0; right:0; bottom:0; z-index:10;
    padding:0 10px calc(env(safe-area-inset-bottom) + 10px) 10px;
    display:flex; flex-direction:column; gap:7px; pointer-events:none; }
  #hud > * { pointer-events:auto; }

  #cats { display:flex; gap:6px; overflow-x:auto; padding:6px 8px; scrollbar-width:none; }
  #cats::-webkit-scrollbar { display:none; }
  .cat { flex:0 0 auto; height:40px; padding:0 16px; border-radius:20px; border:none; font-size:14px;
    font-weight:600; background:rgba(255,255,255,.6); color:#444; touch-action:manipulation; cursor:pointer; }
  .cat.sel { background:#1a73e8; color:#fff; }

  #palette { display:flex; gap:8px; overflow-x:auto; padding:8px 10px; scrollbar-width:none; }
  #palette::-webkit-scrollbar { display:none; }
  .swatch { flex:0 0 42px; height:42px; border-radius:50%; border:3px solid rgba(0,0,0,.15); cursor:pointer;
    touch-action:manipulation; }
  .swatch.sel { border:4px solid #1a73e8; box-shadow:0 0 0 3px rgba(26,115,232,.3); }

  #tray { display:flex; gap:8px; overflow-x:auto; padding:8px; scrollbar-width:none; }
  #tray::-webkit-scrollbar { display:none; }
  .thumb { flex:0 0 74px; height:90px; border-radius:14px; background:rgba(255,255,255,.65);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    border:3px solid transparent; cursor:pointer; touch-action:manipulation; }
  .thumb img { width:60px; height:60px; pointer-events:none; }
  .thumb .cap { font-size:10px; font-weight:600; color:#555; pointer-events:none; text-align:center; }
  .thumb.sel { border-color:#1a73e8; background:#e3efff; }

  #fabs { position:absolute; right:calc(env(safe-area-inset-right) + 12px); bottom:250px; z-index:10;
    display:flex; flex-direction:column; gap:12px; }
  .fab { width:56px; height:56px; border-radius:50%; border:none; font-size:25px; cursor:pointer;
    background:rgba(255,255,255,.85); backdrop-filter:blur(10px); box-shadow:0 4px 14px rgba(0,0,0,.2);
    display:flex; align-items:center; justify-content:center; touch-action:manipulation; color:#333; }
  .fab:active { transform:scale(.94); }
  .fab.hidden, .hidden { display:none !important; }
  #fabOk { background:#34a853; color:#fff; }
  #fabDel { background:#ea4335; color:#fff; }

  /* play mode UI */
  #stickZone { position:absolute; left:0; bottom:0; width:45%; height:45%; z-index:9; touch-action:none; }
  #stick { position:absolute; left:34px; bottom:calc(env(safe-area-inset-bottom) + 34px); width:124px; height:124px;
    border-radius:50%; background:rgba(255,255,255,.25); border:2px solid rgba(255,255,255,.55); z-index:10;
    touch-action:none; }
  #knob { position:absolute; left:50%; top:50%; width:54px; height:54px; margin:-27px 0 0 -27px; border-radius:50%;
    background:rgba(255,255,255,.85); box-shadow:0 3px 10px rgba(0,0,0,.25); pointer-events:none; }
  #jumpBtn { position:absolute; right:calc(env(safe-area-inset-right) + 26px);
    bottom:calc(env(safe-area-inset-bottom) + 40px); width:74px; height:74px; border-radius:50%; border:none;
    background:rgba(255,255,255,.8); font-size:30px; z-index:10; touch-action:manipulation;
    box-shadow:0 4px 14px rgba(0,0,0,.25); }
  #jumpBtn:active { background:#ffe9a8; }
  #trainHud { position:absolute; inset:0; z-index:11; pointer-events:none; }
  #trainHud > * { pointer-events:auto; }
  #throttleBox { position:absolute; left:calc(env(safe-area-inset-left) + 24px);
    bottom:calc(env(safe-area-inset-bottom) + 28px); display:flex; flex-direction:column; align-items:center;
    gap:6px; background:rgba(255,255,255,.72); border-radius:22px; padding:10px 8px;
    backdrop-filter:blur(12px); box-shadow:0 4px 14px rgba(0,0,0,.2); }
  #throttleBox button { width:66px; height:56px; border:none; border-radius:16px; font-size:24px;
    background:#fff; color:#333; touch-action:manipulation; box-shadow:0 2px 6px rgba(0,0,0,.14); }
  #throttleBox button:active { background:#d8e8ff; }
  #thRead { font-size:15px; font-weight:700; color:#444; min-width:56px; text-align:center; }
  #trView, #trStop, #trExit { position:absolute; border:none; border-radius:28px; height:56px;
    font-size:16px; font-weight:600; color:#333; background:rgba(255,255,255,.82);
    backdrop-filter:blur(12px); box-shadow:0 4px 14px rgba(0,0,0,.2); touch-action:manipulation; }
  #trView { right:calc(env(safe-area-inset-right) + 20px); bottom:calc(env(safe-area-inset-bottom) + 28px);
    padding:0 22px; }
  #trStop { right:calc(env(safe-area-inset-right) + 20px); bottom:calc(env(safe-area-inset-bottom) + 96px);
    width:56px; font-size:20px; color:#c5221f; }
  #trExit { right:calc(env(safe-area-inset-right) + 88px); bottom:calc(env(safe-area-inset-bottom) + 96px);
    width:56px; font-size:20px; }
  #zoomBtns { position:absolute; right:calc(env(safe-area-inset-right) + 34px);
    bottom:calc(env(safe-area-inset-bottom) + 132px); z-index:10; display:flex; flex-direction:column; gap:10px; }
  #zoomBtns button { width:56px; height:56px; border-radius:50%; border:none; font-size:26px; font-weight:600;
    color:#333; background:rgba(255,255,255,.8); box-shadow:0 4px 12px rgba(0,0,0,.22);
    touch-action:manipulation; display:flex; align-items:center; justify-content:center; }
  #zoomBtns button:active { background:#d8e8ff; }
  #minimap { position:absolute; top:calc(env(safe-area-inset-top) + 74px); right:calc(env(safe-area-inset-right) + 12px);
    width:132px; height:132px; border-radius:14px; z-index:10; background:#1c4e2a;
    box-shadow:0 4px 14px rgba(0,0,0,.25); }

  /* sheets */
  .sheet { position:absolute; inset:0; z-index:60; display:flex; align-items:center; justify-content:center;
    background:rgba(0,0,0,.4); }
  .sheet .card { background:#fff; border-radius:22px; width:min(560px, 94vw); max-height:88vh;
    display:flex; flex-direction:column; overflow:hidden; }
  .sheet .head { display:flex; align-items:center; justify-content:space-between; padding:14px 18px;
    border-bottom:1px solid #eee; }
  .sheet .head h2 { font-size:18px; color:#222; }
  .sheet .head button { width:42px; height:42px; border-radius:50%; border:none; background:#f0f0f0; font-size:18px; }
  .sheet .body { padding:14px 18px calc(env(safe-area-inset-bottom) + 14px); overflow-y:auto;
    -webkit-overflow-scrolling:touch; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(120px, 1fr)); gap:10px; }
  .card-item { border:2px solid #e5e5e5; border-radius:14px; padding:10px; text-align:center; cursor:pointer;
    background:#fafafa; touch-action:manipulation; }
  .card-item.sel { border-color:#1a73e8; background:#e8f1ff; }
  .card-item .big { font-size:34px; }
  .card-item .nm { font-size:13px; font-weight:600; color:#333; margin-top:4px; word-break:break-word; }
  .card-item img { width:100%; border-radius:8px; background:#dfeeff; }
  .rowbtns { display:flex; gap:8px; flex-wrap:wrap; margin:10px 0; }
  .pbtn { padding:11px 16px; border-radius:12px; border:none; font-size:15px; font-weight:600;
    background:#eef2f6; color:#333; cursor:pointer; touch-action:manipulation; }
  .pbtn.primary { background:#1a73e8; color:#fff; }
  .pbtn.danger { background:#fce8e6; color:#c5221f; }
  .tabs { display:flex; gap:6px; margin-bottom:12px; flex-wrap:wrap; }
  .tab { padding:9px 15px; border-radius:18px; border:none; background:#eef2f6; font-size:14px; font-weight:600;
    color:#444; cursor:pointer; touch-action:manipulation; }
  .tab.sel { background:#1a73e8; color:#fff; }
  input[type=text] { font-size:16px; padding:11px 12px; border-radius:12px; border:2px solid #ddd; width:100%; }
  #avPreview { width:min(280px, 60vw); height:min(280px, 60vw); margin:0 auto; display:block; border-radius:16px;
    background:linear-gradient(#bfe0f7,#eef8ff); touch-action:none; }
  .savedrow { display:flex; align-items:center; gap:8px; padding:9px 4px; border-bottom:1px solid #f0f0f0; }
  .savedrow .nm { flex:1; font-size:15px; font-weight:600; color:#333; }
  .savedrow button { padding:9px 13px; border-radius:10px; border:none; background:#eef2f6; font-size:14px; }
  .boardpick { display:grid; grid-template-columns:repeat(5, 44px); gap:5px; justify-content:center; margin:12px 0; }
  .boardpick button { width:44px; height:44px; border-radius:9px; border:2px solid #cfe0cf; background:#e9f5e9; }
  .boardpick button.sel { background:#1a73e8; border-color:#1a73e8; }

  #modal { position:absolute; inset:0; z-index:70; display:flex; align-items:center; justify-content:center;
    background:rgba(0,0,0,.35); }
  #modal .card { background:#fff; border-radius:20px; padding:26px; max-width:340px; text-align:center; }
  #modal .card p { font-size:17px; margin-bottom:20px; color:#333; }
  #modal .card div { display:flex; gap:12px; justify-content:center; }
  #modal button { font-size:16px; padding:12px 24px; border-radius:13px; border:none; cursor:pointer; }
  #modalYes { background:#ea4335; color:#fff; }
  #modalNo { background:#eee; color:#333; }

  #toast { position:absolute; top:calc(env(safe-area-inset-top) + 72px); left:50%; transform:translateX(-50%);
    background:rgba(30,30,30,.85); color:#fff; font-size:14px; padding:9px 18px; border-radius:20px;
    opacity:0; transition:opacity .25s; pointer-events:none; z-index:80; }

  #overlay { position:absolute; inset:0; z-index:90; display:flex; flex-direction:column; gap:14px;
    align-items:center; justify-content:center; background:linear-gradient(#7ec3f0,#e8f5ff);
    font-size:18px; color:#1c4e73; text-align:center; padding:24px; }
  #overlay button { font-size:17px; padding:12px 22px; border-radius:14px; border:none; background:#1a73e8; color:#fff; }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="topbar" class="panel">
  <button class="btn" id="bProfile" title="Profiles">👤</button>
  <button class="btn" id="bUndo" title="Undo">↶</button>
  <button class="btn" id="bRedo" title="Redo">↷</button>
  <span id="count">0</span>
  <button class="btn" id="bDemos" title="Demos">🏰</button>
  <button class="btn" id="bAvatar" title="Avatar">🙂</button>
  <button class="btn" id="bErase" title="Eraser">🧽</button>
  <button class="btn" id="bPlay" title="Play mode">🎮</button>
  <button class="btn" id="bTrain" title="Drive the train">🚂</button>
  <button class="btn" id="bMore" title="More">⋯</button>
</div>

<div id="fabs">
  <button class="fab hidden" id="fabRot" title="Rotate 90°">⟳</button>
  <button class="fab hidden" id="fabOk" title="Place">✓</button>
  <button class="fab hidden" id="fabNo" title="Cancel">✕</button>
  <button class="fab hidden" id="fabDel" title="Delete">🗑</button>
</div>

<div id="hud">
  <div id="cats" class="panel"></div>
  <div id="palette" class="panel"></div>
  <div id="tray" class="panel"></div>
</div>

<div id="stickZone" class="hidden"></div>
<div id="stick" class="hidden"><div id="knob"></div></div>
<button id="jumpBtn" class="hidden">⬆︎</button>
<div id="zoomBtns" class="hidden">
  <button id="zoomOut" title="Zoom out">−</button>
  <button id="zoomIn" title="Zoom in">＋</button>
</div>
<canvas id="minimap" class="hidden" width="160" height="160"></canvas>

<div id="trainHud" class="hidden">
  <div id="throttleBox">
    <button id="thUp">▲</button>
    <div id="thRead">0</div>
    <button id="thDown">▼</button>
  </div>
  <button id="trView">🚂 Cab</button>
  <button id="trStop">■</button>
  <button id="trExit">✕</button>
</div>

<div id="toast"></div>

<div id="modal" class="hidden">
  <div class="card">
    <p id="modalText"></p>
    <div><button id="modalYes">Yes</button><button id="modalNo">Cancel</button></div>
  </div>
</div>

<div id="sheetProfile" class="sheet hidden"><div class="card">
  <div class="head"><h2>Profiles</h2><button data-close>✕</button></div>
  <div class="body" id="profileBody"></div>
</div></div>

<div id="sheetAvatar" class="sheet hidden"><div class="card">
  <div class="head"><h2>My Minifig</h2><button data-close>✕</button></div>
  <div class="body">
    <canvas id="avPreview" width="560" height="560"></canvas>
    <div class="tabs" id="avTabs"></div>
    <div id="avOptions"></div>
    <div class="rowbtns" style="justify-content:center">
      <button class="pbtn primary" id="avPlay" style="font-size:17px">▶ Play!</button>
    </div>
  </div>
</div></div>

<div id="sheetDemos" class="sheet hidden"><div class="card">
  <div class="head"><h2>Demos</h2><button data-close>✕</button></div>
  <div class="body">
    <div class="tabs">
      <button class="tab sel" id="demoTabBuilds">Builds</button>
      <button class="tab" id="demoTabWorlds">Worlds</button>
    </div>
    <div id="demoGrid" class="grid"></div>
  </div>
</div></div>

<div id="sheetBoard" class="sheet hidden"><div class="card">
  <div class="head"><h2>Choose a board</h2><button data-close>✕</button></div>
  <div class="body">
    <p style="font-size:14px;color:#666;text-align:center">Where should “<span id="boardDemoName"></span>” go?</p>
    <div class="boardpick" id="boardPick"></div>
    <div class="rowbtns" style="justify-content:center">
      <button class="pbtn primary" id="boardLoad">Load here</button>
    </div>
  </div>
</div></div>

<div id="sheetMore" class="sheet hidden"><div class="card">
  <div class="head"><h2>Options</h2><button data-close>✕</button></div>
  <div class="body">
    <div class="rowbtns">
      <button class="pbtn" id="bExport">⬇ Export build file</button>
      <button class="pbtn" id="bImport">⬆ Import build file</button>
      <button class="pbtn danger" id="bClearBoard">🧹 Clear board</button>
      <button class="pbtn danger" id="bClearWorld">🗑 Clear world</button>
    </div>
  </div>
</div></div>

<div id="overlay">
  <div style="font-size:44px">🧱</div>
  <div id="ovText">Loading bricks…</div>
  <button id="ovPick" style="display:none">Choose GLB files</button>
  <input type="file" id="glbFile" accept=".glb" multiple style="display:none">
</div>
<input type="file" id="jsonFile" accept=".json,application/json" style="display:none">

<script>
window.addEventListener('error', e => console.error('UNCAUGHT:', e.message, '@', e.filename, ':', e.lineno));
window.addEventListener('unhandledrejection', e => console.error('UNHANDLED PROMISE:', e.reason && e.reason.message || e.reason));
</script>
<script type="module">
import * as THREE from 'https://cdnjs.cloudflare.com/ajax/libs/three.js/0.180.0/three.module.min.js';

/* ================= constants ================= */
const P = 0.008, PH = 0.0032;
const BOARD = 32, NB = 5, GRID = BOARD * NB, HALF = GRID / 2;
const PROFILE_KEY = 'legoBuilderProfiles_v2';
const OLD_SAVE_KEY = 'legoBuilderSave_v1';

const COLORS = [
  ['red', 0xC4281B], ['blue', 0x0055BF], ['yellow', 0xF2CD37], ['green', 0x237841],
  ['white', 0xF4F4F4], ['black', 0x1B2A34], ['orange', 0xFE8A18], ['tan', 0xE4CD9E],
  ['dark grey', 0x6C6E68], ['light grey', 0xA0A5A9], ['brown', 0x583927], ['lime', 0xBBE90B],
];
const PROP_COLOR = -1;

function rect(w, d, h, s) {
  const cells = [];
  for (let x = 0; x < w; x++) for (let z = 0; z < d; z++) cells.push({ x, z, s });
  return { w, d, h, cells };
}
const DEFS = {};
for (const [w, d] of [[1,1],[1,2],[1,3],[1,4],[1,6],[1,8],[2,2],[2,3],[2,4],[2,6],[2,8]])
  DEFS[`brick_${w}x${d}`] = { ...rect(w, d, 3, 1), cat: 'bricks' };
for (const [w, d] of [[1,2],[1,4],[2,2],[2,4],[2,6],[2,8]])
  DEFS[`plate_${w}x${d}`] = { ...rect(w, d, 1, 1), cat: 'plates' };
DEFS.slope_1x2 = { w:1, d:2, h:3, cat:'special', cells:[{x:0,z:0,s:1},{x:0,z:1,s:0}] };
DEFS.slope_2x4 = { w:2, d:4, h:3, cat:'special', cells:[
  {x:0,z:0,s:1},{x:1,z:0,s:1},{x:0,z:1,s:1},{x:1,z:1,s:1},
  {x:0,z:2,s:1},{x:1,z:2,s:1},{x:0,z:3,s:0},{x:1,z:3,s:0} ] };
DEFS.corner_2x2 = { w:2, d:2, h:3, cat:'special', cells:[{x:0,z:0,s:1},{x:0,z:1,s:1},{x:1,z:0,s:1}] };

const CATS = [['bricks','Bricks'],['plates','Plates'],['special','Special'],
              ['track','🚂 Track'],['home','Home'],['garden','Garden'],['build','Build'],['fun','Fun']];

/* ---- track geometry ----------------------------------------------------
   Real LEGO: straights are 16 studs long x 8 wide, 5-stud gauge; curves are
   22.5 deg at 40-stud radius. 22.5 deg can't live on a stud grid with 90 deg
   rotations, so a curve here is one 90 deg quarter-turn in a 16x16 tile
   (8-stud radius) — four of them close a loop on a single 32x32 board.
   Ports are given in footprint studs; RAIL = rail-top height in plates.    */
const RAIL = 2;
const TRACK = {
  track_straight: { ports: [[4, 0, RAIL], [4, 16, RAIL]], line: [[4, 0], [4, 16]] },
  track_half:     { ports: [[4, 0, RAIL], [4, 8, RAIL]],  line: [[4, 0], [4, 8]] },
  track_bridge:   { ports: [[4, 0, RAIL], [4, 16, RAIL]], line: [[4, 0], [4, 16]] },
  track_ramp:     { ports: [[4, 0, RAIL], [4, 16, RAIL + 6]], line: [[4, 0], [4, 16]] },
  track_long:     { ports: [[4, 0, RAIL], [4, 32, RAIL]], line: [[4, 0], [4, 32]] },
  track_curve:    { ports: [[8, 0, RAIL], [0, 8, RAIL]], arc: { cx: 0, cz: 0, r: 8, a0: 0, a1: Math.PI / 2 } },
  track_curve_big:{ ports: [[16, 0, RAIL], [0, 16, RAIL]], arc: { cx: 0, cz: 0, r: 16, a0: 0, a1: Math.PI / 2 } },
  track_cross:    { ports: [[8, 0, RAIL], [8, 16, RAIL], [0, 8, RAIL], [16, 8, RAIL]],
                    line: [[8, 0], [8, 16]], line2: [[0, 8], [16, 8]] },
  track_buffer:   { ports: [[4, 0, RAIL]], line: [[4, 0], [4, 5]], dead: true },
};
const TRAIN_TYPES = ['train_loco', 'train_car_red', 'train_car_blue', 'train_wagon'];
// rotate a point given in unrotated footprint studs into the rotated footprint
function rotPt(px, pz, w, d, r) {
  if (r === 0) return [px, pz];
  if (r === 1) return [pz, w - px];
  if (r === 2) return [w - px, d - pz];
  return [d - pz, px];
}

const fpCache = new Map();
function footprint(type, r) {
  const key = type + r;
  if (fpCache.has(key)) return fpCache.get(key);
  const def = DEFS[type];
  const w2 = r % 2 ? def.d : def.w, d2 = r % 2 ? def.w : def.d;
  const cells = def.cells.map(c => {
    const ox = c.x + 0.5 - def.w / 2, oz = c.z + 0.5 - def.d / 2;
    let nx, nz;
    if (r === 0) { nx = ox; nz = oz; }
    else if (r === 1) { nx = oz; nz = -ox; }
    else if (r === 2) { nx = -ox; nz = -oz; }
    else { nx = -oz; nz = ox; }
    return { x: Math.round(nx - 0.5 + w2 / 2), z: Math.round(nz - 0.5 + d2 / 2), s: c.s };
  });
  const fp = { w: w2, d: d2, h: def.h, cells };
  fpCache.set(key, fp);
  return fp;
}
function caption(t) {
  if (t.startsWith('prop_')) return t.slice(5).replace(/_/g, ' ');
  if (t.startsWith('track_') || t.startsWith('train_')) return t.slice(6).replace(/_/g, ' ');
  const m = t.match(/(\w+?)_(\d)x(\d)/);
  if (!m) return t.replace(/_/g, ' ');          // never throw — an empty tray is worse than an ugly label
  return m[1] === 'brick' ? `${m[2]}×${m[3]}` : `${m[2]}×${m[3]} ${m[1]}`;
}

/* ================= renderer & scene ================= */
const canvas = document.getElementById('c');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

const scene = new THREE.Scene();
{
  const sc = document.createElement('canvas'); sc.width = 1; sc.height = 256;
  const g = sc.getContext('2d');
  const grad = g.createLinearGradient(0, 0, 0, 256);
  grad.addColorStop(0, '#5fb0e8'); grad.addColorStop(0.62, '#bfe0f7'); grad.addColorStop(1, '#eef8ff');
  g.fillStyle = grad; g.fillRect(0, 0, 1, 256);
  const tex = new THREE.CanvasTexture(sc); tex.colorSpace = THREE.SRGBColorSpace;
  scene.background = tex;
}
scene.fog = new THREE.Fog(0xbfe0f7, 1.6, 4.6);   // pushed back so zoomed-out views stay clear
const camera = new THREE.PerspectiveCamera(46, 1, 0.005, 10);

scene.add(new THREE.HemisphereLight(0xffffff, 0x9db98a, 1.15));
const sun = new THREE.DirectionalLight(0xffffff, 2.2);
sun.position.set(0.5, 1.0, 0.35);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
Object.assign(sun.shadow.camera, { left: -0.75, right: 0.75, top: 0.75, bottom: -0.75, near: 0.1, far: 3 });
sun.shadow.bias = -0.00008;
sun.shadow.normalBias = 0.0015;
scene.add(sun);

{
  const ground = new THREE.Mesh(new THREE.PlaneGeometry(10, 10),
    new THREE.MeshLambertMaterial({ color: 0xcfe6d2 }));
  ground.rotation.x = -Math.PI / 2; ground.position.y = -0.0032;
  ground.receiveShadow = true;
  scene.add(ground);
}
const boardMats = [new THREE.MeshLambertMaterial({ color: 0x2f9e44 }),
                   new THREE.MeshLambertMaterial({ color: 0x38ab50 })];
const baseMeshes = [];
for (let bx = 0; bx < NB; bx++) for (let bz = 0; bz < NB; bz++) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(BOARD * P - 0.0006, 0.003, BOARD * P - 0.0006),
                           boardMats[(bx + bz) % 2]);
  m.position.set((bx * BOARD + BOARD / 2 - HALF) * P, -0.0015, (bz * BOARD + BOARD / 2 - HALF) * P);
  m.receiveShadow = true;
  m.userData.isBoard = true;
  scene.add(m);
  baseMeshes.push(m);
}
{ // studs: one instanced draw call for the whole world
  const studGeo = new THREE.CylinderGeometry(0.0024, 0.0024, 0.0018, 6, 1, false);
  const inst = new THREE.InstancedMesh(studGeo, boardMats[0], GRID * GRID);
  const m = new THREE.Matrix4();
  let i = 0;
  for (let x = 0; x < GRID; x++) for (let z = 0; z < GRID; z++) {
    m.setPosition((x - HALF + 0.5) * P, 0.0009, (z - HALF + 0.5) * P);
    inst.setMatrixAt(i++, m);
  }
  inst.receiveShadow = true;
  scene.add(inst);
}

/* materials */
const matCache = new Map(), selMatCache = new Map(), dragMatCache = new Map();
const propMat = new THREE.MeshLambertMaterial({ vertexColors: true });
const propSelMat = new THREE.MeshLambertMaterial({ vertexColors: true, emissive: 0x2255aa, emissiveIntensity: 0.55 });
const propDragMat = new THREE.MeshLambertMaterial({ vertexColors: true, transparent: true, opacity: 0.55, depthWrite: false });
function matFor(hex) {
  if (hex === PROP_COLOR) return propMat;
  if (!matCache.has(hex)) matCache.set(hex, new THREE.MeshLambertMaterial({ color: hex }));
  return matCache.get(hex);
}
function selMatFor(hex) {
  if (hex === PROP_COLOR) return propSelMat;
  if (!selMatCache.has(hex)) selMatCache.set(hex,
    new THREE.MeshLambertMaterial({ color: hex, emissive: 0x2255aa, emissiveIntensity: 0.55 }));
  return selMatCache.get(hex);
}
function dragMatFor(hex) {
  if (hex === PROP_COLOR) return propDragMat;
  if (!dragMatCache.has(hex)) dragMatCache.set(hex,
    new THREE.MeshLambertMaterial({ color: hex, transparent: true, opacity: 0.55, depthWrite: false }));
  return dragMatCache.get(hex);
}
const ghostOkMat = new THREE.MeshLambertMaterial({ color: 0xffffff, emissive: 0x336633, transparent: true, opacity: 0.5, depthWrite: false });
const ghostBadMat = new THREE.MeshLambertMaterial({ color: 0xff4433, emissive: 0x661111, transparent: true, opacity: 0.5, depthWrite: false });

/* ================= GLB parsing (minimal; GLTFLoader is not hosted on cdnjs) ====== */
function parseGLBraw(buf) {
  const dv = new DataView(buf);
  if (dv.getUint32(0, true) !== 0x46546C67) throw new Error('Not a GLB file');
  const total = dv.getUint32(8, true);
  let off = 12, json = null, bin = null;
  while (off < total) {
    const clen = dv.getUint32(off, true), ctype = dv.getUint32(off + 4, true);
    if (ctype === 0x4E4F534A) json = JSON.parse(new TextDecoder().decode(new Uint8Array(buf, off + 8, clen)));
    else if (ctype === 0x004E4942) bin = buf.slice(off + 8, off + 8 + clen);
    off += 8 + clen;
  }
  const CT = { 5120: Int8Array, 5121: Uint8Array, 5122: Int16Array, 5123: Uint16Array, 5125: Uint32Array, 5126: Float32Array };
  const NC = { SCALAR: 1, VEC2: 2, VEC3: 3, VEC4: 4 };
  const acc = i => {
    const a = json.accessors[i], bv = json.bufferViews[a.bufferView];
    return { arr: new CT[a.componentType](bin, (bv.byteOffset || 0) + (a.byteOffset || 0), a.count * NC[a.type]),
             n: NC[a.type], norm: !!a.normalized };
  };
  const geoOf = mi => {
    const prim = json.meshes[mi].primitives[0];
    const g = new THREE.BufferGeometry();
    const pos = acc(prim.attributes.POSITION);
    g.setAttribute('position', new THREE.BufferAttribute(pos.arr, 3));
    if (prim.attributes.NORMAL !== undefined)
      g.setAttribute('normal', new THREE.BufferAttribute(acc(prim.attributes.NORMAL).arr, 3));
    else g.computeVertexNormals();
    if (prim.attributes.COLOR_0 !== undefined) {
      const c = acc(prim.attributes.COLOR_0);
      g.setAttribute('color', new THREE.BufferAttribute(c.arr, c.n, c.norm));
    }
    if (prim.indices !== undefined) {
      const ix = acc(prim.indices);
      g.setIndex(new THREE.BufferAttribute(ix.arr, 1));
    }
    return g;
  };
  return { json, geoOf };
}
function parseGLB(buf) {           // flat: name -> {geo, extras}
  const { json, geoOf } = parseGLBraw(buf);
  const out = new Map();
  for (const node of json.nodes || []) {
    if (node.mesh === undefined) continue;
    out.set(node.name || json.meshes[node.mesh].name, { geo: geoOf(node.mesh), extras: node.extras || {} });
  }
  return out;
}
function parseGLBtree(buf) {       // hierarchy: name -> {geo, translation, children:[names]}
  const { json, geoOf } = parseGLBraw(buf);
  const out = new Map();
  for (const node of json.nodes || []) {
    out.set(node.name, {
      geo: node.mesh !== undefined ? geoOf(node.mesh) : null,
      t: node.translation || [0, 0, 0],
      children: (node.children || []).map(i => json.nodes[i].name),
    });
  }
  return out;
}

/* ================= state ================= */
let geos = null;          // type -> BufferGeometry (bricks + props)
let figParts = null;      // minifig tree
const placed = new Map();
const cellIndex = new Map();
let nextId = 1;
let curColor = COLORS[0][1];
let selectedId = null;
let ghostType = null, ghostRot = 0, ghostPos = null, ghostValid = false;
const undoStack = [], redoStack = [];
let playMode = false, trainMode = false, eraseMode = false;

const ghostMesh = new THREE.Mesh(new THREE.BoxGeometry(0.001, 0.001, 0.001), ghostOkMat);
ghostMesh.visible = false;
scene.add(ghostMesh);

/* ---------- instanced pools ---------- */
const pools = new Map();
const poolMeshes = [];
const _tmpObj = new THREE.Object3D();
function brickMatrix(b) {
  const fp = footprint(b.type, b.rot);
  _tmpObj.position.set((b.x + fp.w / 2 - HALF) * P, b.base * PH, (b.z + fp.d / 2 - HALF) * P);
  _tmpObj.rotation.set(0, b.rot * Math.PI / 2, 0);
  _tmpObj.scale.set(1, 1, 1);
  _tmpObj.updateMatrix();
  return _tmpObj.matrix;
}
function getPool(type, color) {
  const key = type + '|' + color;
  let p = pools.get(key);
  if (!p) {
    p = { key, geo: geos.get(type), mat: matFor(color), mesh: null, ids: [], cap: 0 };
    pools.set(key, p);
  }
  return p;
}
function poolEnsure(p, need) {
  if (need <= p.cap) return;
  const cap = Math.max(32, p.cap * 2, need);
  const nm = new THREE.InstancedMesh(p.geo, p.mat, cap);
  nm.castShadow = nm.receiveShadow = true;
  nm.frustumCulled = false;   // instance bounds aren't auto-computed; culling uses the origin-centred geometry sphere
  nm.userData.pool = p;
  nm.count = p.ids.length;
  if (p.mesh) {
    nm.instanceMatrix.array.set(p.mesh.instanceMatrix.array.subarray(0, p.ids.length * 16));
    scene.remove(p.mesh);
    poolMeshes.splice(poolMeshes.indexOf(p.mesh), 1);
    p.mesh.dispose();
  }
  scene.add(nm);
  poolMeshes.push(nm);
  p.mesh = nm; p.cap = cap;
}
function poolAdd(b) {
  const p = getPool(b.type, b.color);
  poolEnsure(p, p.ids.length + 1);
  const slot = p.ids.length;
  p.ids.push(b.id);
  p.mesh.setMatrixAt(slot, brickMatrix(b));
  p.mesh.count = p.ids.length;
  p.mesh.instanceMatrix.needsUpdate = true;
  b.pool = p; b.slot = slot;
}
function poolRemove(b) {
  const p = b.pool;
  if (!p) return;
  const last = p.ids.length - 1;
  if (b.slot !== last) {
    const movedId = p.ids[last];
    p.ids[b.slot] = movedId;
    const moved = placed.get(movedId);
    if (moved) moved.slot = b.slot;
    const m = new THREE.Matrix4();
    p.mesh.getMatrixAt(last, m);
    p.mesh.setMatrixAt(b.slot, m);
  }
  p.ids.pop();
  p.mesh.count = p.ids.length;
  p.mesh.instanceMatrix.needsUpdate = true;
  b.pool = null; b.slot = -1;
}
function poolUpdate(b) {
  if (!b.pool) return;
  b.pool.mesh.setMatrixAt(b.slot, brickMatrix(b));
  b.pool.mesh.instanceMatrix.needsUpdate = true;
}

/* solo mesh for selected / dragged brick */
let soloMesh = null, soloId = null;
function soloShow(b, mat) {
  soloHide();
  soloMesh = new THREE.Mesh(geos.get(b.type), mat);
  soloMesh.castShadow = true;
  soloMesh.userData.brickId = b.id;
  scene.add(soloMesh);
  soloId = b.id;
  soloSync(b);
}
function soloSync(b, lift = 0) {
  if (!soloMesh) return;
  const fp = footprint(b.type, b.rot);
  soloMesh.position.set((b.x + fp.w / 2 - HALF) * P, b.base * PH + lift, (b.z + fp.d / 2 - HALF) * P);
  soloMesh.rotation.y = b.rot * Math.PI / 2;
}
function soloHide() {
  if (soloMesh) { scene.remove(soloMesh); soloMesh = null; soloId = null; }
}

/* ---------- placement core ---------- */
function cellKey(x, z) { return x + ',' + z; }
function cellInfo(x, z, excludeId) {
  const m = cellIndex.get(cellKey(x, z));
  let top = 0, stack = true;
  if (m) for (const [id, e] of m) {
    if (id === excludeId) continue;
    if (e.top > top) { top = e.top; stack = e.stack; }
  }
  return { top, stack };
}
function computePlacement(type, rot, x, z, excludeId) {
  const fp = footprint(type, rot);
  if (x < 0 || z < 0 || x + fp.w > GRID || z + fp.d > GRID) return { valid: false, base: 0, fp };
  let base = 0;
  for (const c of fp.cells) {
    const t = cellInfo(x + c.x, z + c.z, excludeId);
    if (t.top > base) base = t.top;
  }
  let valid = true;
  if (base > 0) for (const c of fp.cells) {
    const t = cellInfo(x + c.x, z + c.z, excludeId);
    if (t.top === base && !t.stack) { valid = false; break; }
  }
  return { valid, base, fp };
}
function indexAdd(b) {
  const fp = footprint(b.type, b.rot);
  for (const c of fp.cells) {
    const k = cellKey(b.x + c.x, b.z + c.z);
    if (!cellIndex.has(k)) cellIndex.set(k, new Map());
    cellIndex.get(k).set(b.id, { top: b.base + fp.h, h: fp.h, stack: c.s === 1 });
  }
}
function indexRemove(b) {
  const fp = footprint(b.type, b.rot);
  for (const c of fp.cells) {
    const m = cellIndex.get(cellKey(b.x + c.x, b.z + c.z));
    if (m) m.delete(b.id);
  }
}
function createBrick(data) {
  const b = { ...data };
  if (b.id == null) b.id = nextId++;
  else nextId = Math.max(nextId, b.id + 1);
  placed.set(b.id, b);
  indexAdd(b);
  poolAdd(b);
  return b;
}
function destroyBrick(id) {
  const b = placed.get(id);
  if (!b) return;
  indexRemove(b);
  poolRemove(b);
  if (soloId === id) soloHide();
  placed.delete(id);
  if (selectedId === id) selectedId = null;
}
function plainData(b) { return { id: b.id, type: b.type, color: b.color, x: b.x, z: b.z, base: b.base, rot: b.rot }; }
function moveBrickTo(id, s) {
  const b = placed.get(id);
  indexRemove(b);
  Object.assign(b, s);
  indexAdd(b);
  if (b.pool) poolUpdate(b); else soloSync(b);
}

/* ---------- undo/redo ---------- */
function pushOp(op) {
  undoStack.push(op);
  if (undoStack.length > 120) undoStack.shift();
  redoStack.length = 0;
}
function applyOp(op, dir) {
  if (op.t === 'add') dir > 0 ? createBrick(op.b) : destroyBrick(op.b.id);
  else if (op.t === 'del') dir > 0 ? destroyBrick(op.b.id) : createBrick(op.b);
  else if (op.t === 'move') moveBrickTo(op.id, dir > 0 ? op.to : op.from);
  else if (op.t === 'color') {
    const b = placed.get(op.id);
    if (b) { const c = dir > 0 ? op.to : op.from; poolRemove(b); b.color = c; poolAdd(b); }
  }
  else if (op.t === 'group') {
    if (dir > 0) op.add.forEach(createBrick), op.del.forEach(d => destroyBrick(d.id));
    else op.del.forEach(createBrick), op.add.forEach(a => destroyBrick(a.id));
  }
}
function undo() { const op = undoStack.pop(); if (op) { select(null); applyOp(op, -1); redoStack.push(op); commit(); } }
function redo() { const op = redoStack.pop(); if (op) { select(null); applyOp(op, 1); undoStack.push(op); commit(); } }

/* ---------- profiles & persistence ---------- */
let store = null;
function loadStore() {
  try { store = JSON.parse(localStorage.getItem(PROFILE_KEY)); } catch (e) { store = null; }
  if (!store || !store.profiles) {
    store = { current: 'p1', profiles: { p1: { name: 'Builder', emoji: '🦁', avatar: defaultAvatar(), autosave: null, builds: {} } } };
    try {   // migrate the old single-board save into the centre board
      const old = JSON.parse(localStorage.getItem(OLD_SAVE_KEY));
      if (old && old.bricks) {
        store.profiles.p1.autosave = { v: 2, bricks: old.bricks.map(b => [b[0], b[1], b[2] + 64, b[3] + 64, b[4], b[5]]) };
        localStorage.removeItem(OLD_SAVE_KEY);
      }
    } catch (e) {}
  }
  if (!store.profiles[store.current]) store.current = Object.keys(store.profiles)[0];
}
function prof() { return store.profiles[store.current]; }
function saveStore() { try { localStorage.setItem(PROFILE_KEY, JSON.stringify(store)); } catch (e) {} }
function serialize() {
  return { v: 2, bricks: [...placed.values()].map(b => [b.type, b.color, b.x, b.z, b.base, b.rot]),
           avatar: prof().avatar,
           fig: [Math.floor(play.x / P + HALF), Math.floor(play.z / P + HALF)] };
}
function restore(data) {
  select(null); hideGhost();
  for (const id of [...placed.keys()]) destroyBrick(id);
  if (!data || !Array.isArray(data.bricks)) return;
  const off = data.v === 2 ? 0 : 64;
  for (const [type, color, x, z, base, rot] of data.bricks)
    if (DEFS[type]) createBrick({ type, color, x: x + off, z: z + off, base, rot });
  if (data.avatar) { prof().avatar = { ...defaultAvatar(), ...data.avatar }; refreshFig(); }
  if (Array.isArray(data.fig)) figDropAt(data.fig[0], data.fig[1]);
  else figDropAt(HALF, HALF + 20);
  buildTrackGraph();
}
function commit() {
  prof().autosave = serialize();
  saveStore();
  updateHUD();
  minimapDirty = true;
  if (!trainMode) buildTrackGraph();
}

/* ================= camera ================= */
const cam = { theta: 0.7, phi: 1.05, dist: 0.45, target: new THREE.Vector3(0, 0.015, 0) };
const CAM_DEF = { theta: 0.7, phi: 1.05, dist: 0.45 };
function updateBuildCamera() {
  if (!isFinite(cam.theta + cam.phi + cam.dist + cam.target.x + cam.target.y + cam.target.z)) {
    Object.assign(cam, CAM_DEF);
    cam.target.set(0, 0.015, 0);
  }
  cam.phi = Math.min(1.5, Math.max(0.18, cam.phi));
  cam.dist = Math.min(2.2, Math.max(0.06, cam.dist));
  cam.target.x = Math.min(0.7, Math.max(-0.7, cam.target.x));
  cam.target.z = Math.min(0.7, Math.max(-0.7, cam.target.z));
  cam.target.y = Math.min(0.4, Math.max(0, cam.target.y));
  camera.position.set(
    cam.target.x + cam.dist * Math.sin(cam.phi) * Math.sin(cam.theta),
    cam.target.y + cam.dist * Math.cos(cam.phi),
    cam.target.z + cam.dist * Math.sin(cam.phi) * Math.cos(cam.theta));
  camera.lookAt(cam.target);
}

/* ================= picking ================= */
const raycaster = new THREE.Raycaster();
const ndc = new THREE.Vector2();
function pick(px, py, excludeSolo) {
  const r = canvas.getBoundingClientRect();
  ndc.set(((px - r.left) / r.width) * 2 - 1, -((py - r.top) / r.height) * 2 + 1);
  raycaster.setFromCamera(ndc, camera);
  const targets = poolMeshes.concat(baseMeshes);
  if (soloMesh && !excludeSolo) targets.push(soloMesh);
  if (fig && fig.visible && !playMode) targets.push(fig);
  const hits = raycaster.intersectObjects(targets, true);
  if (!hits.length) return { brick: null, cellX: null, cellZ: null };
  const h = hits[0];
  if (fig && !playMode) {                       // did the ray land on the minifig?
    let o = h.object;
    while (o) { if (o === fig) return { brick: null, fig: true, cellX: null, cellZ: null }; o = o.parent; }
  }
  const cellX = Math.min(GRID - 1, Math.max(0, Math.floor(h.point.x / P + HALF)));
  const cellZ = Math.min(GRID - 1, Math.max(0, Math.floor(h.point.z / P + HALF)));
  let brick = null;
  if (h.object.userData.pool) brick = placed.get(h.object.userData.pool.ids[h.instanceId]);
  else if (h.object.userData.brickId != null) brick = placed.get(h.object.userData.brickId);
  return { brick, cellX, cellZ, point: h.point };
}

/* ================= ghost ================= */
function anchorFromCell(type, rot, cellX, cellZ) {
  const fp = footprint(type, rot);
  let x = cellX - Math.floor((fp.w - 1) / 2);
  let z = cellZ - Math.floor((fp.d - 1) / 2);
  // track and trains live on an 8-stud lattice so pieces always meet end to end
  const lat = latticeOf(type);
  if (lat > 1) { x = Math.round(x / lat) * lat; z = Math.round(z / lat) * lat; }
  x = Math.min(GRID - fp.w, Math.max(0, x));
  z = Math.min(GRID - fp.d, Math.max(0, z));
  if (lat > 1) { x = Math.round(x / lat) * lat; z = Math.round(z / lat) * lat; }
  return { x, z };
}
function latticeOf(type) {
  const d = DEFS[type];
  if (!d) return 1;
  if (TRAIN_TYPES.includes(type)) return 1;   // park the train wherever it looks right
  return d.cat === 'track' ? 4 : 1;           // 4 lets a straight centre on a curve's port
}
// magnetic track: tap near an open rail end and the piece lands exactly on it
function trackSnap(type, rot, x, z, tapX, tapZ) {
  const t = TRACK[type];
  if (!t || tapX == null) return { x, z };
  const def = DEFS[type], fp = footprint(type, rot);
  const local = t.ports.map(([px, pz]) => rotPt(px, pz, def.w, def.d, rot));
  let best = null, bestD = Infinity;
  for (const [k, list] of trackGraph) {
    if (list.length > 1) continue;                       // that joint is already made
    const p = k.split(',').map(Number);
    const dTap = (p[0] - tapX) ** 2 + (p[1] - tapZ) ** 2;
    if (dTap > 169) continue;                            // only rail ends within 13 studs of the tap
    for (const [lx, lz] of local) {
      const ax = p[0] - lx, az = p[1] - lz;
      if (ax < 0 || az < 0 || ax + fp.w > GRID || az + fp.d > GRID) continue;
      const d = dTap * 3 + (ax - x) ** 2 + (az - z) ** 2;
      if (d < bestD) { bestD = d; best = { x: ax, z: az }; }
    }
  }
  return best || { x, z };
}
function setGhost(x, z, tapX, tapZ) {
  if (TRACK[ghostType]) {
    const s = trackSnap(ghostType, ghostRot, x, z, tapX, tapZ);
    x = s.x; z = s.z;
  }
  const res = computePlacement(ghostType, ghostRot, x, z, null);
  ghostPos = { x, z };
  ghostValid = res.valid;
  const fp = res.fp;
  ghostMesh.geometry = geos.get(ghostType);
  ghostMesh.material = res.valid ? ghostOkMat : ghostBadMat;
  ghostMesh.position.set((x + fp.w / 2 - HALF) * P, res.base * PH, (z + fp.d / 2 - HALF) * P);
  ghostMesh.rotation.y = ghostRot * Math.PI / 2;
  ghostMesh.visible = true;
  updateHUD();
}
function refreshGhost() { if (ghostType && ghostPos) setGhost(ghostPos.x, ghostPos.z); }
function hideGhost() {
  ghostType = null; ghostPos = null; ghostMesh.visible = false;
  document.querySelectorAll('.thumb').forEach(t => t.classList.remove('sel'));
  updateHUD();
}
function placeGhost() {
  if (!ghostType || !ghostPos || !ghostValid) return;
  const res = computePlacement(ghostType, ghostRot, ghostPos.x, ghostPos.z, null);
  if (!res.valid) return;
  const isProp = ghostType.startsWith('prop_');
  const b = createBrick({ type: ghostType, color: isProp ? PROP_COLOR : curColor,
                          x: ghostPos.x, z: ghostPos.z, base: res.base, rot: ghostRot });
  pushOp({ t: 'add', b: plainData(b) });
  commit();
  refreshGhost();
}

/* ================= selection ================= */
function select(id) {
  if (selectedId != null && placed.has(selectedId)) {
    const old = placed.get(selectedId);
    if (!old.pool) { soloHide(); poolAdd(old); }
  }
  selectedId = id;
  if (id != null) {
    hideGhost();
    const b = placed.get(id);
    poolRemove(b);
    soloShow(b, selMatFor(b.color));
  }
  updateHUD();
}
function deleteSelected() {
  if (selectedId == null) return;
  const b = placed.get(selectedId);
  pushOp({ t: 'del', b: plainData(b) });
  destroyBrick(selectedId);
  commit();
}
function rotateAction() {
  if (ghostType) {
    ghostRot = (ghostRot + 1) % 4;
    if (ghostPos) {
      const old = footprint(ghostType, (ghostRot + 3) % 4);
      const cx = ghostPos.x + old.w / 2, cz = ghostPos.z + old.d / 2;
      const fp = footprint(ghostType, ghostRot);
      setGhost(
        Math.min(GRID - fp.w, Math.max(0, Math.round(cx - fp.w / 2))),
        Math.min(GRID - fp.d, Math.max(0, Math.round(cz - fp.d / 2))));
    }
  } else if (selectedId != null) {
    const b = placed.get(selectedId);
    const from = { x: b.x, z: b.z, base: b.base, rot: b.rot };
    const oldFp = footprint(b.type, b.rot);
    const cx = b.x + oldFp.w / 2, cz = b.z + oldFp.d / 2;
    const newRot = (b.rot + 1) % 4;
    const fp = footprint(b.type, newRot);
    const nx = Math.min(GRID - fp.w, Math.max(0, Math.round(cx - fp.w / 2)));
    const nz = Math.min(GRID - fp.d, Math.max(0, Math.round(cz - fp.d / 2)));
    const res = computePlacement(b.type, newRot, nx, nz, b.id);
    if (!res.valid) { toast("Can't rotate here"); return; }
    const to = { x: nx, z: nz, base: res.base, rot: newRot };
    moveBrickTo(b.id, to);
    pushOp({ t: 'move', id: b.id, from, to });
    commit();
  }
}

/* ================= pointer input (build mode + camera) ================= */
const pointers = new Map();
let mode = null;
let longTimer = null;
let drag = null;
let two = null;

canvas.addEventListener('pointerdown', e => {
  e.preventDefault();
  if (e.isPrimary) { pointers.clear(); mode = null; }   // phantom-touch guard (freeze fix)
  try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
  pointers.set(e.pointerId, { x: e.clientX, y: e.clientY, sx: e.clientX, sy: e.clientY });
  clearTimeout(longTimer);
  if (playMode) {
    if (pointers.size === 2) {                       // two fingers = pinch zoom
      const [a, b] = [...pointers.values()];
      two = { dist: Math.hypot(a.x - b.x, a.y - b.y) };
      mode = 'playzoom';
    } else mode = 'chase';
    return;
  }

  if (pointers.size === 1) {
    const hit = pick(e.clientX, e.clientY);
    mode = 'tap';
    drag = null;
    if (hit.fig && !eraseMode) {
      mode = 'dragFig';
      drag = { moved: false };
    } else if (ghostType && ghostPos && hit.cellX != null && overGhost(hit)) {
      mode = 'dragGhost';
      drag = { offx: ghostPos.x - hit.cellX, offz: ghostPos.z - hit.cellZ, moved: false };
    } else if (hit.brick && hit.brick.id === selectedId && !ghostType) {
      const b = hit.brick;
      mode = 'dragBrick';
      indexRemove(b);
      soloShow(b, dragMatFor(b.color));
      drag = { id: b.id, offx: b.x - hit.cellX, offz: b.z - hit.cellZ,
               from: { x: b.x, z: b.z, base: b.base, rot: b.rot }, valid: true, moved: false };
    } else if (hit.brick && !ghostType) {
      const id = hit.brick.id;
      longTimer = setTimeout(() => {
        if (mode === 'tap' && placed.has(id)) {
          const b = placed.get(id);
          pushOp({ t: 'del', b: plainData(b) });
          destroyBrick(id);
          commit(); toast('Deleted');
          mode = 'done';
        }
      }, 560);
    }
  } else if (pointers.size === 2 && mode !== 'dragBrick' && mode !== 'dragGhost') {
    mode = 'two';
    const [a, b] = [...pointers.values()];
    two = { dist: Math.hypot(a.x - b.x, a.y - b.y),
            ang: Math.atan2(b.y - a.y, b.x - a.x),
            mx: (a.x + b.x) / 2, my: (a.y + b.y) / 2, twist: 0 };
  }
});

function overGhost(hit) {
  if (!ghostPos) return false;
  const fp = footprint(ghostType, ghostRot);
  return hit.cellX >= ghostPos.x && hit.cellX < ghostPos.x + fp.w &&
         hit.cellZ >= ghostPos.z && hit.cellZ < ghostPos.z + fp.d;
}

canvas.addEventListener('pointermove', e => {
  const p = pointers.get(e.pointerId);
  if (!p) return;
  const dx = e.clientX - p.x, dy = e.clientY - p.y;
  p.x = e.clientX; p.y = e.clientY;

  if (playMode) {
    if (mode === 'chase' && e.isPrimary) { chase.theta -= dx * 0.007; chase.phi -= dy * 0.006; }
    else if (mode === 'playzoom' && pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (d > 8 && two.dist > 8) chase.dist *= two.dist / d;
      two.dist = d;
    }
    return;
  }
  if (mode === 'tap' && Math.hypot(p.x - p.sx, p.y - p.sy) > 9) {
    mode = 'orbit';
    clearTimeout(longTimer);
  }
  if (mode === 'orbit' && pointers.size === 1 && e.isPrimary) {
    cam.theta -= dx * 0.006;
    cam.phi -= dy * 0.006;
  } else if (mode === 'dragGhost' && e.isPrimary) {
    const hit = pick(e.clientX, e.clientY);
    if (hit.cellX != null) {
      const fp = footprint(ghostType, ghostRot);
      const lat = latticeOf(ghostType);
      let nx = hit.cellX + drag.offx, nz = hit.cellZ + drag.offz;
      if (lat > 1) { nx = Math.round(nx / lat) * lat; nz = Math.round(nz / lat) * lat; }
      nx = Math.min(GRID - fp.w, Math.max(0, nx));
      nz = Math.min(GRID - fp.d, Math.max(0, nz));
      if (!ghostPos || nx !== ghostPos.x || nz !== ghostPos.z) {
        drag.moved = true;
        setGhost(nx, nz, hit.cellX, hit.cellZ);
      }
    }
  } else if (mode === 'dragFig' && e.isPrimary) {
    const hit = pick(e.clientX, e.clientY);
    if (hit.cellX != null) {
      drag.moved = true;
      selectFig(true);
      figDropAt(hit.cellX, hit.cellZ);
    }
  } else if (mode === 'dragBrick' && e.isPrimary) {
    const b = placed.get(drag.id);
    const hit = pick(e.clientX, e.clientY, true);
    if (hit.cellX != null) {
      drag.moved = true;
      const fp = footprint(b.type, b.rot);
      b.x = Math.min(GRID - fp.w, Math.max(0, hit.cellX + drag.offx));
      b.z = Math.min(GRID - fp.d, Math.max(0, hit.cellZ + drag.offz));
      const res = computePlacement(b.type, b.rot, b.x, b.z, b.id);
      drag.valid = res.valid;
      b.base = res.base;
      soloMesh.material = res.valid ? dragMatFor(b.color) : ghostBadMat;
      soloSync(b, 0.005);
    }
  } else if (mode === 'two' && pointers.size === 2) {
    const [a, b] = [...pointers.values()];
    const dist = Math.hypot(a.x - b.x, a.y - b.y);
    const ang = Math.atan2(b.y - a.y, b.x - a.x);
    const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
    if (dist > 8 && two.dist > 8) cam.dist *= two.dist / dist;   // guard: no div-by-zero NaN (freeze fix)
    const k = cam.dist * 0.0016;
    const st = Math.sin(cam.theta), ct = Math.cos(cam.theta);
    cam.target.x -= (mx - two.mx) * k * ct - (my - two.my) * k * -st;
    cam.target.z -= (mx - two.mx) * k * -st + (my - two.my) * k * -ct;
    let da = ang - two.ang;
    if (da > Math.PI) da -= 2 * Math.PI;
    if (da < -Math.PI) da += 2 * Math.PI;
    two.twist += da;
    if (Math.abs(two.twist) > 0.62 && (ghostType || selectedId != null)) {
      rotateAction();
      two.twist = 0;
    }
    two.dist = dist; two.ang = ang; two.mx = mx; two.my = my;
  }
});

function endPointer(e) {
  const p = pointers.get(e.pointerId);
  if (!p) return;
  clearTimeout(longTimer);
  if (!playMode) {
    if (mode === 'tap' && e.type === 'pointerup') handleTap(e);
    else if (mode === 'dragGhost') {
      if (drag && !drag.moved && e.type === 'pointerup' && ghostValid) placeGhost();
      drag = null;
    }
    else if (mode === 'dragFig') { selectFig(true); commit(); drag = null; }
    else if (mode === 'dragBrick' && drag) {
      const b = placed.get(drag.id);
      if (drag.valid) {
        indexAdd(b);
        soloShow(b, selMatFor(b.color));
        const to = { x: b.x, z: b.z, base: b.base, rot: b.rot };
        if (drag.moved && (to.x !== drag.from.x || to.z !== drag.from.z || to.base !== drag.from.base))
          pushOp({ t: 'move', id: b.id, from: drag.from, to });
        commit();
      } else {
        Object.assign(b, drag.from);
        indexAdd(b);
        soloShow(b, selMatFor(b.color));
      }
      drag = null;
    }
  }
  pointers.delete(e.pointerId);
  if (pointers.size === 0) mode = null;
  else if (pointers.size === 1 && mode === 'two') {
    const [a] = [...pointers.values()];
    a.sx = a.x; a.sy = a.y;
    mode = 'orbit';
  }
  else if (pointers.size === 1 && mode === 'playzoom') mode = 'chase';
}
canvas.addEventListener('pointerup', endPointer);
canvas.addEventListener('pointercancel', endPointer);
window.addEventListener('pointerup', e => { if (pointers.has(e.pointerId)) endPointer(e); });
window.addEventListener('pointercancel', e => { if (pointers.has(e.pointerId)) endPointer(e); });
window.addEventListener('blur', () => { pointers.clear(); mode = null; });   // freeze fix
document.addEventListener('visibilitychange', () => { if (document.hidden) { pointers.clear(); mode = null; } });

function handleTap(e) {
  const hit = pick(e.clientX, e.clientY);
  if (eraseMode) {
    if (hit.brick) {
      pushOp({ t: 'del', b: plainData(hit.brick) });
      destroyBrick(hit.brick.id);
      commit();
    }
    return;
  }
  if (hit.fig) { selectFig(true); return; }
  if (ghostType) {
    if (hit.cellX == null) return;
    const { x, z } = anchorFromCell(ghostType, ghostRot, hit.cellX, hit.cellZ);
    if (ghostPos && overGhost(hit) && ghostValid) placeGhost();
    else {
      const before = ghostPos ? ghostPos.x + ',' + ghostPos.z : '';
      setGhost(x, z, hit.cellX, hit.cellZ);
      if (ghostPos && before === ghostPos.x + ',' + ghostPos.z && ghostValid) placeGhost();
    }
  } else if (hit.brick) {
    select(hit.brick.id);
  } else {
    select(null); selectFig(false);
  }
}
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  if (playMode) chase.dist *= 1 + e.deltaY * 0.0012;
  else cam.dist *= 1 + e.deltaY * 0.0012;
}, { passive: false });
document.addEventListener('gesturestart', e => e.preventDefault());
canvas.addEventListener('contextmenu', e => e.preventDefault());

/* ================= minifig / avatar ================= */
const FACES = ['happy', 'wink', 'glasses', 'beard'];
const HAIRS = ['hair_short', 'hair_long', 'hair_ponytail', 'hat_cap', 'hat_helmet', 'none'];
const ACCS = ['acc_sword', 'acc_wand', 'acc_hammer', 'acc_mug', 'acc_torch', 'none'];
const HAIR_COLORS = [0x1B2A34, 0x583927, 0xF2CD37, 0xC4281B, 0xA0A5A9, 0x0055BF, 0xE06A9F];
function defaultAvatar() {
  return { legs: 0x0055BF, torso: 0xC4281B, arms: 0xC4281B, face: 'happy',
           hair: 'hair_short', hairColor: 0x583927, acc: 'none' };
}
function faceTexture(style) {
  const cv = document.createElement('canvas'); cv.width = cv.height = 128;
  const g = cv.getContext('2d');
  g.clearRect(0, 0, 128, 128);
  g.fillStyle = '#1b1b1b';
  const eye = (x, wink) => {
    if (wink) { g.fillRect(x - 9, 46, 18, 5); }
    else { g.beginPath(); g.arc(x, 46, 8, 0, 7); g.fill(); }
  };
  eye(44, false); eye(84, style === 'wink');
  g.strokeStyle = '#1b1b1b'; g.lineWidth = 6; g.lineCap = 'round';
  g.beginPath(); g.arc(64, 66, 26, 0.25 * Math.PI, 0.75 * Math.PI); g.stroke();
  if (style === 'glasses') {
    g.lineWidth = 5;
    g.strokeRect(28, 32, 30, 26); g.strokeRect(70, 32, 30, 26);
    g.beginPath(); g.moveTo(58, 42); g.lineTo(70, 42); g.stroke();
  }
  if (style === 'beard') {
    g.fillStyle = '#4a2f18';
    g.beginPath(); g.arc(64, 76, 32, 0.15 * Math.PI, 0.85 * Math.PI); g.lineTo(64, 118); g.fill();
  }
  const tex = new THREE.CanvasTexture(cv);
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}
const faceTexCache = new Map();
function buildFigure(av) {
  const g = new THREE.Group();
  const mk = (name, mat) => {
    const part = figParts.get(name);
    const m = new THREE.Mesh(part.geo, mat);
    m.castShadow = true;
    return m;
  };
  const legsMat = matFor(av.legs), torsoMat = matFor(av.torso), armsMat = matFor(av.arms);
  const headMat = matFor(0xF2CD37);
  const legsRoot = new THREE.Group();
  legsRoot.position.y = 0.0115;
  legsRoot.add(mk('fig_legs', legsMat));
  const legL = new THREE.Group(), legR = new THREE.Group();
  legL.position.fromArray(figParts.get('leg_L').t);
  legR.position.fromArray(figParts.get('leg_R').t);
  legL.add(mk('leg_L', legsMat)); legR.add(mk('leg_R', legsMat));
  legsRoot.add(legL, legR);
  const torso = new THREE.Group();
  torso.position.y = 0.0115 + 0.0045;
  torso.add(mk('fig_torso', torsoMat));
  const armL = new THREE.Group(), armR = new THREE.Group();
  armL.position.fromArray(figParts.get('arm_L').t);
  armR.position.fromArray(figParts.get('arm_R').t);
  armL.add(mk('arm_L', armsMat)); armR.add(mk('arm_R', armsMat));
  torso.add(armL, armR);
  const head = new THREE.Group();
  head.position.y = torso.position.y + 0.0144;
  head.add(mk('fig_head', headMat));
  if (!faceTexCache.has(av.face)) faceTexCache.set(av.face, faceTexture(av.face));
  const face = new THREE.Mesh(new THREE.PlaneGeometry(0.0085, 0.0062),
    new THREE.MeshBasicMaterial({ map: faceTexCache.get(av.face), transparent: true }));
  face.position.set(0, 0.0036, 0.00545);
  head.add(face);
  if (av.hair !== 'none') {
    const hair = mk(av.hair, matFor(av.hairColor));
    hair.position.y = 0.0068;
    head.add(hair);
  }
  if (av.acc !== 'none') {
    const acc = mk(av.acc, matFor(0xA0A5A9));
    acc.position.set(0.0008, -0.0105, -0.0022);
    acc.rotation.x = -0.3;
    armR.add(acc);
  }
  g.add(legsRoot, torso, head);
  g.userData = { legL, legR, armL, armR };
  return g;
}

/* fig in world */
let fig = null;
const play = { x: 0, z: 0, y: 0, vy: 0, yaw: 0, phase: 0, grounded: true, sprint: false };
function refreshFig() {
  if (!figParts) return;
  if (fig) scene.remove(fig);
  fig = buildFigure(prof().avatar);
  fig.visible = !trainMode;
  scene.add(fig);
  updateFigTransform();
}
function updateFigTransform() {
  if (!fig) return;
  fig.position.set(play.x, play.y, play.z);
  fig.rotation.y = play.yaw;
}
/* ---- the minifig is a movable object in Build Mode ---- */
let figSelected = false;
const figRing = new THREE.Mesh(
  new THREE.TorusGeometry(0.011, 0.0013, 6, 22),
  new THREE.MeshBasicMaterial({ color: 0x1a73e8 }));
figRing.rotation.x = Math.PI / 2;
figRing.visible = false;
scene.add(figRing);
function selectFig(on) {
  figSelected = on && !playMode;
  figRing.visible = figSelected;
  if (figSelected) { select(null); hideGhost(); }
  updateHUD();
}
function figDropAt(cellX, cellZ) {
  cellX = Math.min(GRID - 1, Math.max(0, cellX));
  cellZ = Math.min(GRID - 1, Math.max(0, cellZ));
  play.x = (cellX + 0.5 - HALF) * P;
  play.z = (cellZ + 0.5 - HALF) * P;
  play.y = groundAt(play.x, play.z, 10);
  play.vy = 0;
  updateFigTransform();
  figRing.position.set(play.x, play.y + 0.0006, play.z);
}

/* ---------- play physics ---------- */
const FIG_H = 0.038, FIG_R = 0.0055, CLIMB = 0.0066, GRAV = 0.9, JUMPV = 0.145;
const chase = { theta: 0.6, phi: 1.15, dist: 0.085 };
const CHASE_MIN = 0.03, CHASE_MAX = 1.3;   // 1.3 pulls right back over the whole 5x5 world
const stickV = { x: 0, y: 0 };
const keys = {};
function cellsAround(x, z) {
  const out = [];
  const c0x = Math.floor((x - FIG_R) / P + HALF), c1x = Math.floor((x + FIG_R) / P + HALF);
  const c0z = Math.floor((z - FIG_R) / P + HALF), c1z = Math.floor((z + FIG_R) / P + HALF);
  for (let cx = c0x; cx <= c1x; cx++) for (let cz = c0z; cz <= c1z; cz++) out.push([cx, cz]);
  return out;
}
const PASSABLE = new Set(['prop_gate_arch', 'prop_arch', 'prop_door', 'prop_door_arch', 'prop_fence_gate']);
function blockedAt(x, z, feetY) {
  for (const [cx, cz] of cellsAround(x, z)) {
    if (cx < 0 || cz < 0 || cx >= GRID || cz >= GRID) return true;   // invisible walls
    const m = cellIndex.get(cellKey(cx, cz));
    if (!m) continue;
    for (const [id, e] of m) {
      const b = placed.get(id);
      if (b && PASSABLE.has(b.type)) continue;    // walk through doors, arches and gates
      const top = e.top * PH, bottom = (e.top - e.h) * PH;
      if (top > feetY + CLIMB + 1e-5 && bottom < feetY + FIG_H - 0.002) return true;
    }
  }
  return false;
}
function groundAt(x, z, feetY) {
  let g = 0;
  for (const [cx, cz] of cellsAround(x, z)) {
    if (cx < 0 || cz < 0 || cx >= GRID || cz >= GRID) continue;
    const m = cellIndex.get(cellKey(cx, cz));
    if (!m) continue;
    for (const e of m.values()) {
      const top = e.top * PH;
      if (top <= feetY + CLIMB + 1e-5 && top > g) g = top;
    }
  }
  return g;
}
function stepPlay(dt) {
  let ix = stickV.x, iz = stickV.y;
  if (keys.w || keys.ArrowUp) iz -= 1;
  if (keys.s || keys.ArrowDown) iz += 1;
  if (keys.a || keys.ArrowLeft) ix -= 1;
  if (keys.d || keys.ArrowRight) ix += 1;
  const len = Math.hypot(ix, iz);
  let speed = 0;
  if (len > 0.1) {
    ix /= Math.max(1, len); iz /= Math.max(1, len);
    speed = (play.sprint || keys.Shift) ? 0.10 : 0.055;
    const st = Math.sin(chase.theta), ct = Math.cos(chase.theta);
    const wx = (ix * ct + iz * st) * speed;
    const wz = (-ix * st + iz * ct) * speed;
    const nx = play.x + wx * dt, nz = play.z + wz * dt;
    if (!blockedAt(nx, play.z, play.y)) play.x = nx;
    if (!blockedAt(play.x, nz, play.y)) play.z = nz;
    const targetYaw = Math.atan2(wx, wz);
    let dy = targetYaw - play.yaw;
    while (dy > Math.PI) dy -= 2 * Math.PI;
    while (dy < -Math.PI) dy += 2 * Math.PI;
    play.yaw += dy * Math.min(1, dt * 14);
    play.phase += dt * (play.sprint ? 17 : 11);
  } else {
    play.phase *= Math.max(0, 1 - dt * 10);
  }
  // vertical
  const g = groundAt(play.x, play.z, play.y + 0.0001);
  play.vy -= GRAV * dt;
  play.y += play.vy * dt;
  const floor = groundAt(play.x, play.z, Math.max(play.y, g));
  if (play.y <= floor) { play.y = floor; play.vy = 0; play.grounded = true; }
  else if (play.grounded && g >= play.y - 0.0001 && play.vy <= 0) { play.y = g; play.vy = 0; }
  else play.grounded = false;
  const wl = (HALF - 0.5) * P;
  play.x = Math.min(wl, Math.max(-wl, play.x));
  play.z = Math.min(wl, Math.max(-wl, play.z));
  // animate
  if (fig) {
    const s = Math.sin(play.phase) * Math.min(1, speed * 25);
    fig.userData.legL.rotation.x = s * 0.75;
    fig.userData.legR.rotation.x = -s * 0.75;
    fig.userData.armL.rotation.x = -s * 0.65;
    fig.userData.armR.rotation.x = s * 0.65;
  }
  updateFigTransform();
  // chase camera
  chase.dist = Math.min(CHASE_MAX, Math.max(CHASE_MIN, chase.dist));
  // the further you pull back, the more the camera lifts — otherwise a far, low
  // camera just stares through walls
  const phiCap = chase.dist > 0.25 ? Math.max(0.7, 1.45 - (chase.dist - 0.25) * 1.15) : 1.45;
  chase.phi = Math.min(phiCap, Math.max(0.32, chase.phi));
  if (!isFinite(chase.theta + chase.phi + chase.dist)) Object.assign(chase, { theta: 0.6, phi: 1.15, dist: 0.085 });
  camera.position.set(
    play.x + chase.dist * Math.sin(chase.phi) * Math.sin(chase.theta),
    play.y + 0.03 + chase.dist * Math.cos(chase.phi),
    play.z + chase.dist * Math.sin(chase.phi) * Math.cos(chase.theta));
  camera.lookAt(play.x, play.y + 0.022, play.z);
}
function doJump() { if (play.grounded) { play.vy = JUMPV; play.grounded = false; } }
window.addEventListener('keydown', e => { keys[e.key.length === 1 ? e.key.toLowerCase() : e.key] = true; if (e.key === ' ') doJump(); });
window.addEventListener('keyup', e => { keys[e.key.length === 1 ? e.key.toLowerCase() : e.key] = false; });

/* thumbstick */
{
  const stick = document.getElementById('stick');
  const knob = document.getElementById('knob');
  const zone = document.getElementById('stickZone');
  let sid = null, lastTap = 0;
  const setKnob = (dx, dy) => { knob.style.transform = `translate(${dx}px, ${dy}px)`; };
  const from = e => {
    const r = stick.getBoundingClientRect();
    let dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
    const d = Math.hypot(dx, dy), max = r.width / 2 - 10;
    if (d > max) { dx *= max / d; dy *= max / d; }
    stickV.x = dx / max; stickV.y = dy / max;
    setKnob(dx, dy);
  };
  const down = e => {
    e.preventDefault();
    if (sid != null) return;
    sid = e.pointerId;
    zone.setPointerCapture(e.pointerId);
    const now = performance.now();
    play.sprint = (now - lastTap) < 320;
    lastTap = now;
    from(e);
  };
  const move = e => { if (e.pointerId === sid) from(e); };
  const up = e => {
    if (e.pointerId !== sid) return;
    sid = null; stickV.x = stickV.y = 0; play.sprint = false; setKnob(0, 0);
  };
  for (const el of [zone, stick]) {
    el.addEventListener('pointerdown', down);
    el.addEventListener('pointermove', move);
    el.addEventListener('pointerup', up);
    el.addEventListener('pointercancel', up);
  }
}
document.getElementById('jumpBtn').addEventListener('pointerdown', e => { e.preventDefault(); doJump(); });
for (const [id, f] of [['zoomOut', 1.45], ['zoomIn', 1 / 1.45]])
  document.getElementById(id).addEventListener('pointerdown', e => {
    e.preventDefault();
    chase.dist = Math.min(CHASE_MAX, Math.max(CHASE_MIN, chase.dist * f));
  });

/* minimap */
const mmCanvas = document.getElementById('minimap');
const mmCtx = mmCanvas.getContext('2d');
const mmLayer = document.createElement('canvas'); mmLayer.width = mmLayer.height = 160;
let minimapDirty = true;
function drawMinimapLayer() {
  const g = mmLayer.getContext('2d');
  g.fillStyle = '#2a7d3c'; g.fillRect(0, 0, 160, 160);
  g.strokeStyle = 'rgba(255,255,255,.25)';
  for (let i = 1; i < NB; i++) {
    g.beginPath(); g.moveTo(i * 32, 0); g.lineTo(i * 32, 160); g.stroke();
    g.beginPath(); g.moveTo(0, i * 32); g.lineTo(160, i * 32); g.stroke();
  }
  for (const b of placed.values()) {
    const fp = footprint(b.type, b.rot);
    g.fillStyle = b.color === PROP_COLOR ? '#8a6d3b' : '#' + b.color.toString(16).padStart(6, '0');
    g.fillRect(b.x, b.z, fp.w, fp.d);
  }
  minimapDirty = false;
}
function drawMinimap() {
  if (minimapDirty) drawMinimapLayer();
  mmCtx.drawImage(mmLayer, 0, 0);
  const mx = play.x / P + HALF, mz = play.z / P + HALF;
  mmCtx.fillStyle = '#fff';
  mmCtx.strokeStyle = '#1a73e8'; mmCtx.lineWidth = 3;
  mmCtx.beginPath(); mmCtx.arc(mx, mz, 4.5, 0, 7); mmCtx.fill(); mmCtx.stroke();
}

/* ---------- play mode toggle ---------- */
function setPlayMode(on) {
  if (on && !figParts) { toast('Minifig not loaded'); return; }
  playMode = on;
  select(null); hideGhost();
  document.getElementById('hud').classList.toggle('hidden', on);
  document.getElementById('fabs').classList.toggle('hidden', on);
  for (const id of ['stick', 'jumpBtn', 'minimap', 'stickZone', 'zoomBtns'])
    document.getElementById(id).classList.toggle('hidden', !on);
  document.getElementById('bPlay').classList.toggle('on', on);
  if (on) {
    if (!fig) refreshFig();
    if (fig) fig.visible = true;
    play.x = Math.min(Math.max(play.x, -HALF * P), HALF * P);
    const g = groundAt(play.x, play.z, 1);
    play.y = groundAt(play.x, play.z, g + 1);
    play.vy = 0;
    minimapDirty = true;
  } else if (fig) fig.visible = true;   // the fig stays on the board in Build Mode
  updateHUD();
}

/* ---------- train mode toggle ---------- */
function setTrainMode(on) {
  if (on) {
    if (!geos || !geos.get('train_loco')) { toast('Track pieces not loaded'); return; }
    if (!startTrain()) return;
    train.autoPlay = !playMode;
    if (!playMode) { playMode = true; document.getElementById('hud').classList.add('hidden');
                     document.getElementById('fabs').classList.add('hidden'); }
    select(null); hideGhost();
  } else {
    if (train.on) stopTrain();
    trainMode = false;
    if (train.autoPlay) { train.autoPlay = false; setPlayMode(false); }
  }
  trainMode = on;
  for (const id of ['stick', 'jumpBtn', 'stickZone', 'zoomBtns'])
    document.getElementById(id).classList.toggle('hidden', on || !playMode);
  document.getElementById('minimap').classList.toggle('hidden', !playMode && !on);
  document.getElementById('trainHud').classList.toggle('hidden', !on);
  document.getElementById('bTrain').classList.toggle('on', on);
  if (!on && playMode) { if (fig) fig.visible = true; }
  minimapDirty = true;
  updateHUD();
}

/* ================= track network + drivable train ================= */
function isTrack(b) { return b && TRACK[b.type]; }
function portsOf(b) {
  const def = DEFS[b.type], t = TRACK[b.type];
  return t.ports.map(([px, pz, ph], i) => {
    const [rx, rz] = rotPt(px, pz, def.w, def.d, b.rot);
    return { i, x: b.x + rx, z: b.z + rz, y: b.base + ph };
  });
}
let trackGraph = new Map();
function buildTrackGraph() {
  trackGraph = new Map();
  for (const b of placed.values()) {
    if (!isTrack(b)) continue;
    for (const p of portsOf(b)) {
      const k = p.x + ',' + p.z + ',' + p.y;
      if (!trackGraph.has(k)) trackGraph.set(k, []);
      trackGraph.get(k).push({ id: b.id, i: p.i });
    }
  }
  return trackGraph;
}
function pathLen(b, li) {
  const t = TRACK[b.type];
  if (t.arc) return t.arc.r * (t.arc.a1 - t.arc.a0);
  const l = li ? t.line2 : t.line;
  return Math.hypot(l[1][0] - l[0][0], l[1][1] - l[0][1]);
}
function pathPoint(b, li, u) {
  const def = DEFS[b.type], t = TRACK[b.type];
  let px, pz;
  if (t.arc) {
    const th = t.arc.a0 + u * (t.arc.a1 - t.arc.a0);
    px = t.arc.cx + t.arc.r * Math.cos(th);
    pz = t.arc.cz + t.arc.r * Math.sin(th);
  } else {
    const l = li ? t.line2 : t.line;
    px = l[0][0] + (l[1][0] - l[0][0]) * u;
    pz = l[0][1] + (l[1][1] - l[0][1]) * u;
  }
  const [rx, rz] = rotPt(px, pz, def.w, def.d, b.rot);
  const a = t.ports[li * 2], c = t.ports[li * 2 + 1] || a;
  return { x: (b.x + rx - HALF) * P, z: (b.z + rz - HALF) * P,
           y: (b.base + a[2] + (c[2] - a[2]) * u) * PH };
}
function neighbourAt(b, portIdx) {
  const p = portsOf(b)[portIdx];
  if (!p) return null;
  const list = trackGraph.get(p.x + ',' + p.z + ',' + p.y);
  if (!list) return null;
  for (const e of list) if (!(e.id === b.id && e.i === portIdx)) return e;
  return null;
}
// move `ds` studs along the network; returns a new state (blocked at dead ends)
function stepAlong(st, ds) {
  let { id, li, u, dir } = st;
  for (let guard = 0; guard < 64; guard++) {
    const b = placed.get(id);
    if (!isTrack(b)) return { id, li, u, dir, blocked: true };
    const len = pathLen(b, li);
    u += dir * ds / len;
    ds = 0;
    if (u >= 0 && u <= 1) return { id, li, u, dir, blocked: false };
    const end = u > 1 ? 1 : 0;
    const over = (u > 1 ? u - 1 : -u) * len;
    const nb = neighbourAt(b, li * 2 + end);
    if (!nb) return { id, li, u: end, dir, blocked: true };
    const b2 = placed.get(nb.id);
    if (!isTrack(b2)) return { id, li, u: end, dir, blocked: true };
    id = nb.id; li = nb.i >> 1;
    const end2 = nb.i & 1;
    u = end2 === 0 ? 0 : 1;
    dir = end2 === 0 ? 1 : -1;
    ds = over;
  }
  return { id, li, u, dir, blocked: true };
}
function poseAt(st) {
  const b = placed.get(st.id);
  if (!isTrack(b)) return null;
  const e = 0.02;
  const a = pathPoint(b, st.li, Math.max(0, Math.min(1, st.u)));
  const c = pathPoint(b, st.li, Math.max(0, Math.min(1, st.u + st.dir * e)));
  let yaw = Math.atan2(c.x - a.x, c.z - a.z);
  if (Math.abs(c.x - a.x) < 1e-9 && Math.abs(c.z - a.z) < 1e-9) yaw = 0;
  return { x: a.x, y: a.y, z: a.z, yaw };
}

// a rigid 16-stud vehicle chords across a curve; sit it on its two bogies instead
const BOGIE = 5;
function bogiePose(st) {
  const pf = poseAt(stepAlong(st, BOGIE)), pr = poseAt(stepAlong(st, -BOGIE));
  if (!pf || !pr) return poseAt(st);
  const dx = pf.x - pr.x, dz = pf.z - pr.z;
  if (Math.abs(dx) < 1e-9 && Math.abs(dz) < 1e-9) return poseAt(st);
  return { x: (pf.x + pr.x) / 2, y: (pf.y + pr.y) / 2, z: (pf.z + pr.z) / 2,
           yaw: Math.atan2(dx, dz) };
}
const train = { on: false, st: null, speed: 0, cars: [], meshes: [], hiddenIds: [], view: 0 };
const TRAIN_VIEWS = ['🚂 Cab', '🎥 Chase', '🛩 Above'];
const CAR_GAP = 18;   // studs between vehicle centres

function findLoco() {
  for (const b of placed.values()) if (b.type === 'train_loco') return b;
  return null;
}
function trackUnder(cx, cz) {
  let best = null, bestD = Infinity;
  for (const b of placed.values()) {
    if (!isTrack(b) || TRACK[b.type].dead) continue;
    const def = DEFS[b.type], fp = footprint(b.type, b.rot);
    const mx = b.x + fp.w / 2, mz = b.z + fp.d / 2;
    const d = (mx - cx) ** 2 + (mz - cz) ** 2;
    if (d < bestD) { bestD = d; best = b; }
  }
  return bestD < 26 * 26 ? best : null;
}
function startTrain() {
  buildTrackGraph();
  const loco = findLoco();
  if (!loco) { toast('Place a locomotive on the track first'); return false; }
  const fp = footprint(loco.type, loco.rot);
  const seed = trackUnder(loco.x + fp.w / 2, loco.z + fp.d / 2);
  if (!seed) { toast('Put the loco on a piece of track'); return false; }
  // hide the parked vehicles and drive copies of them instead
  train.hiddenIds = [];
  train.cars = [];
  const carTypes = [];
  for (const b of placed.values()) if (TRAIN_TYPES.includes(b.type)) {
    train.hiddenIds.push({ id: b.id, data: plainData(b) });
    if (b.type !== 'train_loco') carTypes.push(b.type);
  }
  for (const h of train.hiddenIds) destroyBrick(h.id);
  buildTrackGraph();
  train.meshes = [];
  for (const type of ['train_loco', ...carTypes.slice(0, 4)]) {
    const m = new THREE.Mesh(geos.get(type), propMat);
    m.castShadow = true;
    scene.add(m);
    train.meshes.push(m);
  }
  train.st = { id: seed.id, li: 0, u: 0.5, dir: 1, blocked: false };
  train.speed = 0;
  train.on = true;
  return true;
}
function stopTrain() {
  for (const m of train.meshes) scene.remove(m);
  train.meshes = [];
  // park the vehicles back where they were
  for (const h of train.hiddenIds) if (!placed.has(h.id)) createBrick(h.data);
  train.hiddenIds = [];
  train.on = false;
  train.speed = 0;
  commit();
}
function stepTrain(dt) {
  if (!train.st) return;
  const ds = train.speed * dt / P;                // studs this frame
  if (ds) {
    const next = stepAlong(train.st, ds);
    if (next.blocked && Math.abs(train.speed) > 0.001) { train.speed = 0; toast('End of the line'); }
    train.st = next;
  }
  const head = poseAt(train.st);
  if (!head) { train.speed = 0; return; }
  let st = train.st;
  for (let i = 0; i < train.meshes.length; i++) {
    if (i > 0) st = stepAlong(st, -CAR_GAP);
    const p = bogiePose(st);
    if (!p) break;
    train.meshes[i].position.set(p.x, p.y, p.z);
    train.meshes[i].rotation.y = p.yaw;
  }
  // keep the fig riding along with the loco so the minimap dot follows it
  play.x = head.x; play.z = head.z; play.y = head.y;
  if (fig) fig.visible = false;
  const fwd = new THREE.Vector3(Math.sin(head.yaw), 0, Math.cos(head.yaw));
  if (train.view === 0) {          // driver's seat: over the boiler, looking down the line
    camera.position.set(head.x - fwd.x * 0.012, head.y + 0.080, head.z - fwd.z * 0.012);
    camera.lookAt(head.x + fwd.x * 0.7, head.y + 0.012, head.z + fwd.z * 0.7);
  } else if (train.view === 1) {   // chase: clear of the carriage roofs
    camera.position.set(head.x - fwd.x * 0.245, head.y + 0.125, head.z - fwd.z * 0.245);
    camera.lookAt(head.x + fwd.x * 0.10, head.y + 0.022, head.z + fwd.z * 0.10);
  } else {                         // high overhead
    camera.position.set(head.x - fwd.x * 0.20, head.y + 0.33, head.z - fwd.z * 0.20);
    camera.lookAt(head.x, head.y, head.z);
  }
}

/* ================= UI ================= */
const $ = id => document.getElementById(id);
function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.style.opacity = 1;
  clearTimeout(t._h);
  t._h = setTimeout(() => t.style.opacity = 0, 1500);
}
function ask(text, cb) {
  $('modalText').textContent = text;
  $('modal').classList.remove('hidden');
  $('modalYes').onclick = () => { $('modal').classList.add('hidden'); cb(); };
}
$('modalNo').onclick = () => $('modal').classList.add('hidden');
document.querySelectorAll('.sheet [data-close]').forEach(b =>
  b.onclick = () => b.closest('.sheet').classList.add('hidden'));
function openSheet(id) {
  document.querySelectorAll('.sheet').forEach(s => s.classList.add('hidden'));
  $(id).classList.remove('hidden');
}
function updateHUD() {
  $('count').textContent = placed.size;
  $('bUndo').disabled = !undoStack.length;
  $('bRedo').disabled = !redoStack.length;
  $('fabRot').classList.toggle('hidden', playMode || (!ghostType && selectedId == null));
  $('fabOk').classList.toggle('hidden', playMode || !(ghostType && ghostPos && ghostValid));
  $('fabNo').classList.toggle('hidden', playMode || !ghostType);
  $('fabDel').classList.toggle('hidden', playMode || selectedId == null);
  $('bErase').classList.toggle('on', eraseMode);
  $('bTrain').classList.toggle('on', trainMode);
  $('bProfile').textContent = prof() ? prof().emoji : '👤';
}
$('bUndo').onclick = undo;
$('bRedo').onclick = redo;
$('fabRot').onclick = rotateAction;
$('fabOk').onclick = placeGhost;
$('fabNo').onclick = hideGhost;
$('fabDel').onclick = deleteSelected;
$('bPlay').onclick = () => { if (trainMode) setTrainMode(false); setPlayMode(!playMode); };
$('bMore').onclick = () => openSheet('sheetMore');
$('bErase').onclick = () => {
  eraseMode = !eraseMode;
  if (eraseMode) { select(null); hideGhost(); }
  $('bErase').classList.toggle('on', eraseMode);
  toast(eraseMode ? 'Eraser on — tap bricks to remove' : 'Eraser off');
  updateHUD();
};
$('bTrain').onclick = () => setTrainMode(!trainMode);
/* train controls */
const THROTTLE = [0, 0.06, 0.12, 0.22, 0.34];
let notch = 0;
function setNotch(n) {
  notch = Math.max(-4, Math.min(4, n));
  train.speed = Math.sign(notch) * THROTTLE[Math.abs(notch)];
  $('thRead').textContent = notch === 0 ? 'STOP' : (notch > 0 ? '▲ ' : '▼ ') + Math.abs(notch);
}
$('thUp').onclick = () => setNotch(notch + 1);
$('thDown').onclick = () => setNotch(notch - 1);
$('trStop').onclick = () => setNotch(0);
$('trExit').onclick = () => setTrainMode(false);
$('trView').onclick = () => {
  train.view = (train.view + 1) % TRAIN_VIEWS.length;
  $('trView').textContent = TRAIN_VIEWS[train.view];
};

$('bClearBoard').onclick = () => {
  $('sheetMore').classList.add('hidden');
  const bx = Math.floor((cam.target.x / P + HALF) / BOARD), bz = Math.floor((cam.target.z / P + HALF) / BOARD);
  ask(`Clear the board you're looking at?`, () => {
    const del = [...placed.values()].filter(b =>
      Math.floor(b.x / BOARD) === bx && Math.floor(b.z / BOARD) === bz).map(plainData);
    if (!del.length) return;
    pushOp({ t: 'group', add: [], del });
    del.forEach(d => destroyBrick(d.id));
    commit();
  });
};
$('bClearWorld').onclick = () => {
  $('sheetMore').classList.add('hidden');
  ask('Clear the whole world?', () => {
    if (!placed.size) return;
    pushOp({ t: 'group', add: [], del: [...placed.values()].map(plainData) });
    for (const id of [...placed.keys()]) destroyBrick(id);
    commit();
  });
};
$('bExport').onclick = () => {
  const blob = new Blob([JSON.stringify(serialize())], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = (prof().name || 'build') + '-world.json';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  toast('Exported');
};
$('bImport').onclick = () => $('jsonFile').click();
$('jsonFile').onchange = async e => {
  const f = e.target.files[0];
  if (!f) return;
  try {
    restore(JSON.parse(await f.text()));
    undoStack.length = redoStack.length = 0;
    commit();
    toast('Loaded');
    $('sheetMore').classList.add('hidden');
  } catch (err) { toast('Could not read that file'); }
  e.target.value = '';
};

/* palette */
for (const [name, hex] of COLORS) {
  const b = document.createElement('button');
  b.className = 'swatch';
  b.title = name;
  b.style.background = '#' + hex.toString(16).padStart(6, '0');
  b.onclick = () => {
    curColor = hex;
    document.querySelectorAll('#palette .swatch').forEach(s => s.classList.remove('sel'));
    b.classList.add('sel');
    if (selectedId != null) {
      const br = placed.get(selectedId);
      if (br.color !== PROP_COLOR && br.color !== hex) {
        pushOp({ t: 'color', id: br.id, from: br.color, to: hex });
        br.color = hex;
        soloShow(br, selMatFor(hex));
        commit();
      }
    }
  };
  $('palette').appendChild(b);
}
$('palette').firstChild.classList.add('sel');

/* categorised tray */
let curCat = 'bricks';
const thumbCache = new Map();
let thumbRenderer = null, thumbScene = null, thumbCam = null;
function thumbnail(type) {
  if (thumbCache.has(type)) return thumbCache.get(type);
  if (!thumbRenderer) {
    thumbRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, preserveDrawingBuffer: true });
    thumbRenderer.setSize(120, 120);
    thumbRenderer.setPixelRatio(1);
    thumbScene = new THREE.Scene();
    thumbScene.add(new THREE.HemisphereLight(0xffffff, 0x8899aa, 1.0));
    const dl = new THREE.DirectionalLight(0xffffff, 1.5);
    dl.position.set(1, 1.4, 0.8);
    thumbScene.add(dl);
    thumbCam = new THREE.PerspectiveCamera(30, 1, 0.001, 6);
  }
  const geo = geos.get(type);
  const isProp = type.startsWith('prop_');
  const mesh = new THREE.Mesh(geo, isProp ? propMat : new THREE.MeshLambertMaterial({ color: 0xd8d3cb }));
  thumbScene.add(mesh);
  const bb = new THREE.Box3().setFromObject(mesh);
  const size = bb.getSize(new THREE.Vector3()), ctr = bb.getCenter(new THREE.Vector3());
  const d = Math.max(size.x, size.y, size.z) * 2.1;
  thumbCam.position.set(ctr.x + d * 0.72, ctr.y + d * 0.62, ctr.z + d * 0.72);
  thumbCam.lookAt(ctr);
  thumbRenderer.render(thumbScene, thumbCam);
  const url = thumbRenderer.domElement.toDataURL();
  thumbScene.remove(mesh);
  thumbCache.set(type, url);
  return url;
}
function buildCats() {
  for (const [key, label] of CATS) {
    const b = document.createElement('button');
    b.className = 'cat' + (key === curCat ? ' sel' : '');
    b.textContent = label;
    b.dataset.cat = key;
    b.onclick = () => {
      curCat = key;
      document.querySelectorAll('.cat').forEach(c => c.classList.toggle('sel', c.dataset.cat === key));
      buildTray();
    };
    $('cats').appendChild(b);
  }
}
function buildTray() {
  $('tray').innerHTML = '';
  const types = Object.keys(DEFS).filter(t => DEFS[t].cat === curCat);
  for (const type of types) {
    const div = document.createElement('div');
    div.className = 'thumb' + (ghostType === type ? ' sel' : '');
    div.dataset.type = type;
    div.innerHTML = `<img src="${thumbnail(type)}" alt=""><span class="cap">${caption(type)}</span>`;
    div.onclick = () => {
      if (ghostType === type) { hideGhost(); return; }
      document.querySelectorAll('.thumb').forEach(t => t.classList.remove('sel'));
      div.classList.add('sel');
      select(null);
      ghostType = type;
      const cx = Math.min(GRID - 1, Math.max(0, Math.round(cam.target.x / P + HALF)));
      const cz = Math.min(GRID - 1, Math.max(0, Math.round(cam.target.z / P + HALF)));
      const { x, z } = anchorFromCell(type, ghostRot, cx, cz);
      setGhost(x, z, cx, cz);
    };
    $('tray').appendChild(div);
  }
}

/* ---------- profiles UI ---------- */
const EMOJIS = ['🦁','🐸','🦄','🐙','🚀','🌈','🐶','🐱','🤖','⭐','🦖','🏎️'];
function renderProfiles() {
  const body = $('profileBody');
  body.innerHTML = '';
  const h = document.createElement('div');
  h.innerHTML = `<p style="font-size:14px;color:#666;margin-bottom:8px">Who's building?</p>`;
  body.appendChild(h);
  const grid = document.createElement('div');
  grid.className = 'grid';
  for (const [id, p] of Object.entries(store.profiles)) {
    const c = document.createElement('div');
    c.className = 'card-item' + (id === store.current ? ' sel' : '');
    c.innerHTML = `<div class="big">${p.emoji}</div><div class="nm">${p.name}</div>`;
    c.onclick = () => { switchProfile(id); renderProfiles(); };
    grid.appendChild(c);
  }
  const add = document.createElement('div');
  add.className = 'card-item';
  add.innerHTML = `<div class="big">＋</div><div class="nm">New profile</div>`;
  add.onclick = () => {
    const name = prompt('Name?');
    if (!name) return;
    const id = 'p' + Date.now();
    store.profiles[id] = { name: name.slice(0, 14), emoji: EMOJIS[Object.keys(store.profiles).length % EMOJIS.length],
                           avatar: defaultAvatar(), autosave: null, builds: {} };
    switchProfile(id);
    renderProfiles();
  };
  grid.appendChild(add);
  body.appendChild(grid);

  // saved builds of current profile
  const p = prof();
  const sec = document.createElement('div');
  sec.innerHTML = `<p style="font-size:14px;color:#666;margin:16px 0 6px">${p.name}'s saved builds</p>`;
  body.appendChild(sec);
  const row = document.createElement('div');
  row.className = 'rowbtns';
  const saveBtn = document.createElement('button');
  saveBtn.className = 'pbtn primary';
  saveBtn.textContent = '💾 Save current build';
  saveBtn.onclick = () => {
    const name = prompt('Build name?', 'My build ' + (Object.keys(p.builds).length + 1));
    if (!name) return;
    p.builds[name.slice(0, 24)] = { ...serialize(), ts: new Date().toISOString() };
    saveStore();
    renderProfiles();
    toast('Saved “' + name + '”');
  };
  row.appendChild(saveBtn);
  body.appendChild(row);
  for (const [name, data] of Object.entries(p.builds)) {
    const r = document.createElement('div');
    r.className = 'savedrow';
    r.innerHTML = `<span class="nm">🧱 ${name} <span style="color:#999;font-weight:400">(${data.bricks.length})</span></span>`;
    const load = document.createElement('button');
    load.textContent = 'Load';
    load.onclick = () => ask(`Load “${name}”? Current world is replaced.`, () => {
      restore(data);
      undoStack.length = redoStack.length = 0;
      commit();
      $('sheetProfile').classList.add('hidden');
    });
    const del = document.createElement('button');
    del.textContent = '🗑';
    del.onclick = () => ask(`Delete saved build “${name}”?`, () => { delete p.builds[name]; saveStore(); renderProfiles(); });
    r.append(load, del);
    body.appendChild(r);
  }
  // rename / delete profile
  const row2 = document.createElement('div');
  row2.className = 'rowbtns';
  const ren = document.createElement('button');
  ren.className = 'pbtn'; ren.textContent = '✏️ Rename';
  ren.onclick = () => { const n = prompt('New name?', p.name); if (n) { p.name = n.slice(0, 14); saveStore(); renderProfiles(); } };
  row2.appendChild(ren);
  if (Object.keys(store.profiles).length > 1) {
    const dp = document.createElement('button');
    dp.className = 'pbtn danger'; dp.textContent = '🗑 Delete profile';
    dp.onclick = () => ask(`Delete profile “${p.name}” and its saves?`, () => {
      delete store.profiles[store.current];
      store.current = Object.keys(store.profiles)[0];
      switchProfile(store.current, true);
      renderProfiles();
    });
    row2.appendChild(dp);
  }
  body.appendChild(row2);
}
function switchProfile(id, force) {
  if (id === store.current && !force) return;
  prof().autosave = serialize();
  store.current = id;
  saveStore();
  restore(prof().autosave);
  undoStack.length = redoStack.length = 0;
  refreshFig();
  commit();
  toast('Hi ' + prof().name + '!');
}
$('bProfile').onclick = () => { renderProfiles(); openSheet('sheetProfile'); };

/* ---------- avatar UI ---------- */
let avScene = null, avRenderer = null, avCam = null, avFig = null, avSpin = 0.6, avDragging = false;
const AV_TABS = [['legs','Legs'],['torso','Torso'],['arms','Arms'],['face','Face'],['hair','Hair'],['acc','Item']];
let avTab = 'torso';
function avRebuild() {
  if (avFig) avScene.remove(avFig);
  avFig = buildFigure(prof().avatar);
  avFig.position.y = -0.019;
  avScene.add(avFig);
}
function initAvatarSheet() {
  if (avScene) return;
  const cv = $('avPreview');
  avRenderer = new THREE.WebGLRenderer({ canvas: cv, antialias: true, alpha: true });
  avRenderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  avRenderer.setSize(cv.clientWidth || 280, cv.clientHeight || 280, false);
  avScene = new THREE.Scene();
  avScene.add(new THREE.HemisphereLight(0xffffff, 0x8899aa, 1.5));
  const dl = new THREE.DirectionalLight(0xffffff, 2.0);
  dl.position.set(0.5, 1, 0.8);
  avScene.add(dl);
  avCam = new THREE.PerspectiveCamera(30, 1, 0.001, 1);
  avCam.position.set(0, 0.005, 0.085);
  avCam.lookAt(0, 0, 0);
  let px = 0;
  cv.addEventListener('pointerdown', e => { avDragging = true; px = e.clientX; cv.setPointerCapture(e.pointerId); });
  cv.addEventListener('pointermove', e => { if (avDragging) { avSpin = 0; avFig.rotation.y += (e.clientX - px) * 0.02; px = e.clientX; } });
  cv.addEventListener('pointerup', () => { avDragging = false; avSpin = 0.6; });
  for (const [key, label] of AV_TABS) {
    const t = document.createElement('button');
    t.className = 'tab' + (key === avTab ? ' sel' : '');
    t.textContent = label;
    t.dataset.t = key;
    t.onclick = () => { avTab = key; document.querySelectorAll('#avTabs .tab').forEach(x => x.classList.toggle('sel', x.dataset.t === key)); avOptions(); };
    $('avTabs').appendChild(t);
  }
  avOptions();
  avRebuild();
}
function avOptions() {
  const av = prof().avatar;
  const host = $('avOptions');
  host.innerHTML = '';
  const wrap = document.createElement('div');
  wrap.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap;justify-content:center;padding:6px 0';
  const swatches = (list, get, set) => {
    for (const hex of list) {
      const s = document.createElement('button');
      s.className = 'swatch' + (get() === hex ? ' sel' : '');
      s.style.background = '#' + hex.toString(16).padStart(6, '0');
      s.onclick = () => { set(hex); saveStore(); avOptions(); avRebuild(); refreshFig(); };
      wrap.appendChild(s);
    }
  };
  const options = (list, get, set, icons) => {
    for (const v of list) {
      const o = document.createElement('button');
      o.className = 'pbtn' + (get() === v ? ' primary' : '');
      o.textContent = icons?.[v] || v.replace(/^(hair_|hat_|acc_)/, '').replace(/_/g, ' ');
      o.onclick = () => { set(v); saveStore(); avOptions(); avRebuild(); refreshFig(); };
      wrap.appendChild(o);
    }
  };
  const cols = COLORS.map(c => c[1]);
  if (avTab === 'legs') swatches(cols, () => av.legs, v => av.legs = v);
  else if (avTab === 'torso') swatches(cols, () => av.torso, v => av.torso = v);
  else if (avTab === 'arms') swatches(cols, () => av.arms, v => av.arms = v);
  else if (avTab === 'face') options(FACES, () => av.face, v => av.face = v,
    { happy: '😊 happy', wink: '😉 wink', glasses: '🤓 glasses', beard: '🧔 beard' });
  else if (avTab === 'hair') {
    options(HAIRS, () => av.hair, v => av.hair = v);
    const br = document.createElement('div'); br.style.cssText = 'width:100%;height:4px';
    wrap.appendChild(br);
    swatches(HAIR_COLORS, () => av.hairColor, v => av.hairColor = v);
  }
  else if (avTab === 'acc') options(ACCS, () => av.acc, v => av.acc = v,
    { acc_sword: '⚔️ sword', acc_wand: '🪄 wand', acc_hammer: '🔨 hammer', acc_mug: '☕ mug', acc_torch: '🔥 torch', none: '✋ none' });
  host.appendChild(wrap);
}
$('bAvatar').onclick = () => {
  if (!figParts) { toast('Minifig not loaded'); return; }
  initAvatarSheet();
  avRebuild();
  openSheet('sheetAvatar');
};
$('avPlay').onclick = () => {
  $('sheetAvatar').classList.add('hidden');
  play.x = 0; play.z = 0; play.y = groundAt(0, 0, 10);
  refreshFig();
  setPlayMode(true);
};

/* ---------- demos gallery ---------- */
const DEMOS = window.__DEMOS || {};
const WORLDS = window.__WORLDS || {};
let demoTab = 'builds', pickedBoard = 12, pendingDemo = null;
const demoThumbCache = new Map();
function demoThumb(key, data) {
  const ck = demoTab + ':' + key;
  if (demoThumbCache.has(ck)) return demoThumbCache.get(ck);
  thumbnail('brick_1x1');   // ensure thumb renderer exists
  const s = new THREE.Scene();
  s.add(new THREE.HemisphereLight(0xffffff, 0x8899aa, 1.5));
  const dl = new THREE.DirectionalLight(0xffffff, 2.0);
  dl.position.set(1, 1.6, 0.9);
  s.add(dl);
  const world = data.bricks.some(b => b[2] >= BOARD || b[3] >= BOARD);
  const span = world ? GRID : BOARD;
  const plate = new THREE.Mesh(new THREE.BoxGeometry(span * P, 0.003, span * P),
    new THREE.MeshLambertMaterial({ color: 0x2f9e44 }));
  plate.position.y = -0.0015;
  s.add(plate);
  const half = span / 2;
  for (const [type, color, x, z, base, rot] of data.bricks) {
    if (!DEFS[type] || !geos.get(type)) continue;
    const m = new THREE.Mesh(geos.get(type), matFor(color));
    const fp = footprint(type, rot);
    m.position.set((x + fp.w / 2 - half) * P, base * PH, (z + fp.d / 2 - half) * P);
    m.rotation.y = rot * Math.PI / 2;
    s.add(m);
  }
  const d = span * P * 1.15;
  thumbCam.position.set(d * 0.7, d * 0.62, d * 0.7);
  thumbCam.lookAt(0, span * P * 0.06, 0);
  thumbRenderer.render(s, thumbCam);
  const url = thumbRenderer.domElement.toDataURL();
  demoThumbCache.set(ck, url);
  return url;
}
function renderDemoGrid() {
  const grid = $('demoGrid');
  grid.innerHTML = '';
  const src = demoTab === 'builds' ? DEMOS : WORLDS;
  const keys = Object.keys(src);
  if (!keys.length) {
    grid.innerHTML = '<p style="color:#888;font-size:14px">No demos in this file build.</p>';
    return;
  }
  for (const key of keys) {
    const d = src[key];
    const c = document.createElement('div');
    c.className = 'card-item';
    c.innerHTML = `<img loading="lazy"><div class="nm">${d.name}</div>`;
    c.querySelector('img').src = demoThumb(key, d);
    c.onclick = () => {
      if (demoTab === 'worlds') {
        ask(`Load world “${d.name}”? It replaces everything.`, () => {
          loadWorld(d);
          $('sheetDemos').classList.add('hidden');
        });
      } else {
        pendingDemo = d;
        $('boardDemoName').textContent = d.name;
        renderBoardPick();
        openSheet('sheetBoard');
      }
    };
    grid.appendChild(c);
  }
}
$('demoTabBuilds').onclick = () => { demoTab = 'builds'; $('demoTabBuilds').classList.add('sel'); $('demoTabWorlds').classList.remove('sel'); renderDemoGrid(); };
$('demoTabWorlds').onclick = () => { demoTab = 'worlds'; $('demoTabWorlds').classList.add('sel'); $('demoTabBuilds').classList.remove('sel'); renderDemoGrid(); };
$('bDemos').onclick = () => { renderDemoGrid(); openSheet('sheetDemos'); };
function renderBoardPick() {
  const host = $('boardPick');
  host.innerHTML = '';
  for (let bz = 0; bz < NB; bz++) for (let bx = 0; bx < NB; bx++) {
    const i = bz * NB + bx;
    const b = document.createElement('button');
    b.className = i === pickedBoard ? 'sel' : '';
    b.onclick = () => { pickedBoard = i; renderBoardPick(); };
    host.appendChild(b);
  }
}
$('boardLoad').onclick = () => {
  if (!pendingDemo) return;
  const bx = pickedBoard % NB, bz = Math.floor(pickedBoard / NB);
  const add = [];
  let skipped = 0;
  for (const [type, color, x, z, base, rot] of pendingDemo.bricks) {
    if (!DEFS[type]) continue;
    const wx = x + bx * BOARD, wz = z + bz * BOARD;
    const res = computePlacement(type, rot, wx, wz, null);
    if (res.valid && res.base === base) add.push(plainData(createBrick({ type, color, x: wx, z: wz, base, rot })));
    else if (res.valid) add.push(plainData(createBrick({ type, color, x: wx, z: wz, base: res.base, rot })));
    else skipped++;
  }
  if (add.length) pushOp({ t: 'group', add, del: [] });
  commit();
  $('sheetBoard').classList.add('hidden');
  toast(skipped ? `Loaded (${skipped} bricks didn't fit)` : 'Loaded!');
};
function loadWorld(d) {
  const del = [...placed.values()].map(plainData);
  for (const id of [...placed.keys()]) destroyBrick(id);
  const add = [];
  for (const [type, color, x, z, base, rot] of d.bricks)
    if (DEFS[type]) add.push(plainData(createBrick({ type, color, x, z, base, rot })));
  pushOp({ t: 'group', add, del });
  commit();
}

/* ================= boot ================= */
async function fetchGLB(name) {
  const r = await fetch(name);
  if (!r.ok) throw new Error(name);
  return r.arrayBuffer();
}
function initGeos(brickMap, propMap, trackMap) {
  geos = new Map();
  for (const [name, { geo }] of brickMap) geos.set(name, geo);
  if (propMap) for (const [name, { geo, extras }] of propMap) {
    geos.set(name, geo);
    const w = extras.w || 1, d = extras.d || 1, h = Math.max(1, extras.h || 3);
    DEFS[name] = { ...rect(w, d, h, 0), cat: extras.cat || 'fun' };
  }
  if (trackMap) for (const [name, { geo, extras }] of trackMap) {
    geos.set(name, geo);
    const w = extras.w || 8, d = extras.d || 8, h = Math.max(1, extras.h || 2);
    DEFS[name] = { ...rect(w, d, h, 1), cat: 'track', kind: extras.kind || 'straight' };
  }
}
async function boot() {
  loadStore();
  try {
    const [bricksBuf, propsBuf, figBuf, trackBuf] = await Promise.all([
      fetchGLB('lego_bricks.glb'),
      fetchGLB('lego_props.glb').catch(() => null),
      fetchGLB('lego_minifig.glb').catch(() => null),
      fetchGLB('lego_track.glb').catch(() => null),
    ]);
    initGeos(parseGLB(bricksBuf), propsBuf ? parseGLB(propsBuf) : null,
             trackBuf ? parseGLB(trackBuf) : null);
    if (figBuf) figParts = parseGLBtree(figBuf);
    finishBoot();
  } catch (e) {
    $('ovText').textContent = 'Could not load the GLB files automatically.\nDrop lego_bricks.glb / lego_props.glb / lego_minifig.glb here, or pick them:';
    $('ovPick').style.display = 'block';
  }
}
const dropped = {};
function tryDropBoot() {
  if (!dropped.bricks) return;
  initGeos(dropped.bricks, dropped.props || null, dropped.track || null);
  if (dropped.fig) figParts = dropped.figTree;
  finishBoot();
}
function acceptFile(name, buf) {
  if (name.includes('minifig')) { dropped.fig = true; dropped.figTree = parseGLBtree(buf); }
  else if (name.includes('props')) dropped.props = parseGLB(buf);
  else if (name.includes('track')) dropped.track = parseGLB(buf);
  else dropped.bricks = parseGLB(buf);
  tryDropBoot();
}
$('ovPick').onclick = () => $('glbFile').click();
$('glbFile').onchange = async e => {
  for (const f of e.target.files) acceptFile(f.name, await f.arrayBuffer());
};
window.addEventListener('dragover', e => e.preventDefault());
window.addEventListener('drop', async e => {
  e.preventDefault();
  for (const f of e.dataTransfer.files) if (f.name.endsWith('.glb')) acceptFile(f.name, await f.arrayBuffer());
});
function finishBoot() {
  buildCats();
  buildTray();
  refreshFig();
  restore(prof().autosave);
  undoStack.length = redoStack.length = 0;
  if (fig) fig.visible = true;      // stays on the board in Build Mode
  setNotch(0);
  $('overlay').classList.add('hidden');
  updateHUD();
}

function resize() {
  renderer.setSize(innerWidth, innerHeight);
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
}
window.addEventListener('resize', resize);
resize();

let lastT = 0;
window.__frames = 0;
renderer.setAnimationLoop(t => {
  window.__frames++;
  const dt = Math.min(0.05, (t - lastT) / 1000 || 0.016);
  lastT = t;
  if (trainMode) {
    stepTrain(dt);
    drawMinimap();
  } else if (playMode) {
    stepPlay(dt);
    drawMinimap();
  } else {
    updateBuildCamera();
    if (figSelected) figRing.position.set(play.x, play.y + 0.0006, play.z);
  }
  if (!$('sheetAvatar').classList.contains('hidden') && avFig) {
    if (!avDragging) avFig.rotation.y += avSpin * dt;
    avRenderer.render(avScene, avCam);
  }
  renderer.render(scene, camera);
});

boot();

/* debug / generator hooks */
window.app = {
  placed, cellIndex, computePlacement, createBrick, destroyBrick, footprint, serialize, restore,
  select, undo, redo, cam, chase, play, setPlayMode, THREE, scene, DEFS, pools, commit,
  trackSnap, setGhost, placeGhost, anchorFromCell, latticeOf,
  set ghostType(t) { ghostType = t; }, set ghostRot(r) { ghostRot = r; },
  get ghostType() { return ghostType; }, get ghostRot() { return ghostRot; },
  get ghostPos() { return ghostPos; }, get ghostValid() { return ghostValid; },
  get selectedId() { return selectedId; },
  get playMode() { return playMode; },
  stickV, keys, doJump, setTrainMode, train, TRACK, buildTrackGraph, portsOf, stepAlong, poseAt,
  get trackGraph() { return trackGraph; }, get trainMode() { return trainMode; },
  set eraseMode(v) { eraseMode = v; }, get eraseMode() { return eraseMode; },
  selectFig, figDropAt, setNotch: n => setNotch(n),
  put(type, color, x, z, rot = 0) {
    const res = computePlacement(type, rot, x, z, null);
    if (!res.valid) return null;
    return createBrick({ type, color, x, z, base: res.base, rot });
  },
  wipe() { for (const id of [...placed.keys()]) destroyBrick(id); },
};
</script>
